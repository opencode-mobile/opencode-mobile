    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Permission prompt iOS shows the first time the app asks for this access.",
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile ጽሑፍን ወደ ማቅረቢያው ለማስገባት በመሣሪያ ላይ ያለ የንግግር ለይቶ ማወቅን ይጠቀማል። ድምፁ በዚህ መሣሪያ ላይ ብቻ ይቆያል።"
