    "NSCameraUsageDescription" : {
      "comment" : "Permission prompt iOS shows the first time the app asks for this access.",
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile ከኮምፒውተርዎ የOpenCode 2 መገናኛ QR ለመቃኘት ካሜራውን ይጠቀማል።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile kompüterinizdən OpenCode 2 cütləşdirmə QR kodunu skan etmək üçün kameradan istifadə edir."
