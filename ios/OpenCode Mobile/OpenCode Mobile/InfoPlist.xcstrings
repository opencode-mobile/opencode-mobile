        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কম্পোজারে লেখা যোগ করতে OpenCode Mobile ডিভাইসেই স্পিচ রিকগনিশন ব্যবহার করে। অডিও এই ডিভাইসেই থাকে।"
