        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile mətni mesaj yazma sahəsinə daxil etmək üçün cihazda nitq tanıma istifadə edir. Səs bu cihazda qalır."
          }
        },
        "bg" : {
          "stringUnit" : {
