    "NSFaceIDUsageDescription" : {
      "comment" : "Permission prompt iOS shows the first time the app asks for this access.",
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የመተግበሪያ መቆለፊያ ሲበራ OpenCode Mobile መተግበሪያውን ለመክፈት Face ID ይጠቀማል።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
