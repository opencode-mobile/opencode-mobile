<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>FirebaseAutomaticScreenReportingEnabled</key>
	<false/>
	<!-- Collection starts disabled; OpenCodeReleaseObservability enables it per the
	     analytics consent setting right after FirebaseApp.configure() (#755). -->
	<key>FirebaseCrashlyticsCollectionEnabled</key>
	<false/>
	<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
	<false/>
	<key>GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_PERSONALIZATION_SIGNALS</key>
	<false/>
	<key>OpenCodeVerifyCrashlytics</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>OpenCode Mobile uses the camera to scan an OpenCode 2 pairing QR from your computer.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>OpenCode Mobile uses the microphone for on-device composer dictation. Audio stays on this device.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>OpenCode Mobile uses on-device speech recognition to insert text into the composer. Audio stays on this device.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Arbitrary loads stay on deliberately. The server lives on the user's own machine,
		     most often reached as plain http at a LAN or Tailscale IP (100.64.0.0/10). ATS
		     cannot scope cleartext to IP ranges: with NSAllowsArbitraryLoads off, http to a
		     Tailscale IP fails with NSURLErrorDomain -1022 (verified on the simulator), and
		     NSExceptionDomains only takes host names. The scoping therefore lives in
		     CleartextPolicy: http to loopback, private, link-local and Tailscale ranges and to
		     .local / .ts.net / private-DNS names connects silently; any other http host shows
		     an explicit "not encrypted" warning before credentials or a pairing code are sent. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
