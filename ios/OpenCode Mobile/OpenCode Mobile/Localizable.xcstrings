    "feedback.privacy_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ለOpenCode Mobile ቡድን ብቻ ነው የሚደርሰው። የአገልጋይዎን አድራሻ፣ የተጠቃሚ ስም ወይም የይለፍ ቃል በጭራሽ አያካትትም። መዝገቦች በዚህ ስልክ ላይ ሚስጥራዊ መረጃ ይወገድባቸዋል።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnız OpenCode Mobile komandasına göndərilir. Server ünvanınız, istifadəçi adınız və ya şifrəniz heç vaxt daxil edilmir. Jurnallarda məxfi məlumatlar bu telefonda gizlədilir."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стига само до екипа на OpenCode Mobile. Никога не включва адреса на сървъра, потребителското име или паролата ви. Журналите се прикриват на този телефон."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু OpenCode Mobile টিমের কাছে যায়। আপনার সার্ভারের ঠিকানা, ইউজারনেম বা পাসওয়ার্ড কখনো পাঠানো হয় না। লগ থেকে গোপনীয় তথ্য এই ফোনেই সরিয়ে ফেলা হয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šalje se samo timu OpenCode Mobile. Nikad ne sadrži adresu servera, korisničko ime ni lozinku. Zapisi se prikrivaju na ovom telefonu."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només arriba a l'equip d'OpenCode Mobile. Mai inclou l'adreça del servidor, el nom d'usuari ni la contrasenya. Les dades sensibles dels registres s'oculten en aquest telèfon."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odešle se jen týmu OpenCode Mobile. Nikdy neobsahuje adresu serveru, uživatelské jméno ani heslo. Logy se anonymizují na tomto telefonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Går kun til OpenCode Mobile-teamet. Indeholder aldrig din serveradresse, dit brugernavn eller din adgangskode. Logs anonymiseres på denne telefon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geht nur an das OpenCode-Mobile-Team. Enthält nie deine Serveradresse, deinen Benutzernamen oder dein Passwort. Protokolle werden auf diesem Smartphone bereinigt."
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile སྡེ་ཚན་ལུ་རྐྱངམ་ཅིག་འགྱོཝ་ཨིན། ཁྱོད་ཀྱི་སར་བར་གི་ཁ་བྱང་དང་ལག་ལེན་པའི་མིང་ ཡང་ན་ ཆོག་ཡིག་ནམ་ཡང་མི་ཡོདཔ་མས། ཟིན་ཐོ་ཚུ་ཁ་པར་འདི་ནང་ལུ་སྦ་བཞག་ཡོདཔ་ཨིན།"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποστέλλεται μόνο στην ομάδα του OpenCode Mobile. Δεν περιλαμβάνει ποτέ τη διεύθυνση του διακομιστή, το όνομα χρήστη ή τον κωδικό πρόσβασης. Τα αρχεία καταγραφής αποκρύπτουν ευαίσθητα στοιχεία σε αυτό το τηλέφωνο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goes to the OpenCode Mobile team only. Never includes your server address, username or password. Logs are redacted on this phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo llega al equipo de OpenCode Mobile. Nunca incluye la dirección de tu servidor, tu nombre de usuario ni tu contraseña. Los registros se censuran en este teléfono."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läheb ainult OpenCode Mobile'i meeskonnale. Ei sisalda kunagi sinu serveri aadressi, kasutajanime ega parooli. Logidest eemaldatakse sellel telefonil tundlikud andmed."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menee vain OpenCode Mobile -tiimille. Ei sisällä palvelimesi osoitetta, käyttäjätunnustasi tai salasanaasi. Lokit sensuroidaan tässä puhelimessa."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fer einans til OpenCode Mobile toymið. Inniheldur ongantíð ambætaraadressuna, brúkaranavnið ella loyniorðið hjá tær. Viðkvæmar upplýsingar í loggum verða fjaldar á hesum telefonini."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyé uniquement à l’équipe d’OpenCode Mobile. N’inclut jamais l’adresse de votre serveur, votre nom d’utilisateur ni votre mot de passe. Les journaux sont expurgés sur ce téléphone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सिर्फ़ OpenCode Mobile टीम को जाता है। इसमें आपका सर्वर का पता, उपयोगकर्ता नाम या पासवर्ड कभी शामिल नहीं होता। लॉग की संवेदनशील जानकारी इस फ़ोन पर ही छिपा दी जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ide samo timu OpenCode Mobile. Nikad ne uključuje adresu poslužitelja, korisničko ime ni lozinku. Zapisi se redigiraju na ovom telefonu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak az OpenCode Mobile csapatához kerül. Soha nem tartalmazza a kiszolgáló címét, a felhasználónevet vagy a jelszót. A naplókat ezen a telefonon tisztítjuk meg."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ուղարկվում է միայն OpenCode Mobile-ի թիմին։ Երբեք չի ներառում ձեր սերվերի հասցեն, օգտանունը կամ գաղտնաբառը։ Մատյանները քողարկվում են այս հեռախոսում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya dikirim ke tim OpenCode Mobile. Tidak pernah menyertakan alamat server, nama pengguna, atau kata sandi Anda. Log disamarkan di ponsel ini."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fer aðeins til OpenCode Mobile teymisins. Inniheldur aldrei netþjónsslóð, notandanafn eða lykilorð. Annálar eru hreinsaðir í þessum síma."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va solo al team di OpenCode Mobile. Non include mai l'indirizzo del server, il nome utente o la password. I log vengono oscurati su questo telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobileのチームだけに送信されます。サーバーのアドレス、ユーザー名、パスワードは含まれません。ログはこの端末で伏せ字処理されます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მხოლოდ OpenCode Mobile-ის გუნდს ეგზავნება. არასდროს შეიცავს თქვენი სერვერის მისამართს, მომხმარებლის სახელს ან პაროლს. ლოგები ამ ტელეფონზე იწმინდება."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ទៅកាន់ក្រុម OpenCode Mobile តែប៉ុណ្ណោះ។ មិនដែលរួមបញ្ចូលអាសយដ្ឋានម៉ាស៊ីនមេ ឈ្មោះអ្នកប្រើ ឬពាក្យសម្ងាត់របស់អ្នកទេ។ កំណត់ហេតុត្រូវបានលុបទិន្នន័យរសើបនៅលើទូរសព្ទនេះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile 팀에만 전달돼요. 서버 주소, 사용자 이름, 비밀번호는 절대 포함되지 않아요. 로그는 이 휴대폰에서 민감 정보를 가려요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ສົ່ງໃຫ້ທີມ OpenCode Mobile ເທົ່ານັ້ນ. ບໍ່ລວມທີ່ຢູ່ເຊີບເວີ, ຊື່ຜູ້ໃຊ້ ຫຼື ລະຫັດຜ່ານຂອງທ່ານ. ບັນທຶກຖືກປິດບັງໃນໂທລະສັບນີ້."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siunčiama tik OpenCode Mobile komandai. Niekada neįtraukiamas jūsų serverio adresas, naudotojo vardas ar slaptažodis. Žurnalai užtemdomi šiame telefone."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiek nosūtīts tikai OpenCode Mobile komandai. Nekad neietver tava servera adresi, lietotājvārdu vai paroli. Slepenie dati žurnālos tiek noslēpti šajā tālrunī."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Се испраќа само до тимот на OpenCode Mobile. Никогаш не ја вклучува адресата на серверот, корисничкото име или лозинката. Чувствителните податоци во дневниците се прикриваат на овој телефон."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зөвхөн OpenCode Mobile багт очино. Таны серверийн хаяг, хэрэглэгчийн нэр, нууц үгийг хэзээ ч оруулахгүй. Логийн нууц мэдээллийг энэ утсан дээр хасна."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dihantar kepada pasukan OpenCode Mobile sahaja. Tidak pernah menyertakan alamat pelayan, nama pengguna atau kata laluan anda. Log disunting pada telefon ini."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile အဖွဲ့ထံသာ ရောက်ပါမည်။ သင့်ဆာဗာလိပ်စာ၊ အသုံးပြုသူအမည် သို့မဟုတ် စကားဝှက်ကို ဘယ်အခါမှ မထည့်သွင်းပါ။ မှတ်တမ်းများကို ဤဖုန်းပေါ်တွင် ဖုံးကွယ်ထားသည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendes bare til OpenCode Mobile-teamet. Inneholder aldri serveradressen, brukernavnet eller passordet ditt. Logger sladdes på denne telefonen."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile टोलीमा मात्र जान्छ। तपाईंको सर्भर ठेगाना, प्रयोगकर्ता नाम वा पासवर्ड कहिल्यै समावेश हुँदैन। लगहरूबाट संवेदनशील जानकारी यही फोनमा हटाइन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaat alleen naar het OpenCode Mobile-team. Bevat nooit je serveradres, gebruikersnaam of wachtwoord. Gevoelige gegevens worden op deze telefoon uit logs verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trafia tylko do zespołu OpenCode Mobile. Nigdy nie zawiera adresu serwera, nazwy użytkownika ani hasła. Logi są maskowane na tym telefonie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai apenas para a equipe do OpenCode Mobile. Nunca inclui o endereço do servidor, o usuário ou a senha. Os logs são ocultados neste celular."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajunge doar la echipa OpenCode Mobile. Nu include niciodată adresa serverului, numele de utilizator sau parola. Datele sensibile din jurnale sunt eliminate pe acest telefon."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляется только команде OpenCode Mobile. Адрес сервера, имя пользователя и пароль никогда не передаются. Журналы обезличиваются прямо на этом телефоне."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile කණ්ඩායමට පමණක් යයි. ඔබේ සේවාදායක ලිපිනය, පරිශීලක නාමය හෝ මුරපදය කිසිවිටක ඇතුළත් නොවේ. ලොග්වලින් සංවේදී තොරතුරු මෙම දුරකථනයේදීම ඉවත් කෙරේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odošle sa iba tímu OpenCode Mobile. Nikdy neobsahuje adresu servera, používateľské meno ani heslo. Logy sa upravujú na tomto telefóne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gre samo ekipi OpenCode Mobile. Nikoli ne vključuje naslova strežnika, uporabniškega imena ali gesla. Dnevniki so na tem telefonu očiščeni občutljivih podatkov."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shkon vetëm te ekipi i OpenCode Mobile. Nuk përfshin kurrë adresën, emrin e përdoruesit ose fjalëkalimin e serverit. Regjistrat maskohen në këtë telefon."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Иде само тиму OpenCode Mobile. Никада не укључује адресу сервера, корисничко име или лозинку. Осетљиви подаци се из дневника уклањају на овом телефону."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Går bara till OpenCode Mobile-teamet. Innehåller aldrig din serveradress, ditt användarnamn eller lösenord. Loggar maskeras på den här telefonen."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Танҳо ба ҷамоаи OpenCode Mobile мерасад. Суроға, номи корбар ё рамзи сервери шумо ҳеҷ гоҳ дохил намешавад. Логҳо дар худи ин телефон пинҳон карда мешаванд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งถึงทีม OpenCode Mobile เท่านั้น ไม่รวมที่อยู่เซิร์ฟเวอร์ ชื่อผู้ใช้ หรือรหัสผ่านของคุณ บันทึกจะถูกปกปิดข้อมูลบนโทรศัพท์เครื่องนี้"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diňe OpenCode Mobile toparyna barýar. Serwer salgyňyzy, ulanyjy adyňyzy ýa-da parolyňyzy hiç haçan öz içine almaýar. Žurnallar şu telefonda gizlenýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca OpenCode Mobile ekibine gider. Sunucu adresini, kullanıcı adını veya parolanı asla içermez. Günlüklerdeki gizli bilgiler bu telefonda maskelenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилається лише команді OpenCode Mobile. Ніколи не містить адреси сервера, імені користувача чи пароля. Журнали очищуються на цьому телефоні."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faqat OpenCode Mobile jamoasiga boradi. Server manzilingiz, foydalanuvchi nomingiz yoki parolingiz hech qachon kiritilmaydi. Jurnallardagi maxfiy ma’lumotlar shu telefonda yashiriladi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ gửi đến nhóm OpenCode Mobile. Không bao giờ gồm địa chỉ máy chủ, tên người dùng hay mật khẩu của bạn. Nhật ký được ẩn thông tin nhạy cảm ngay trên điện thoại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅发送给 OpenCode Mobile 团队。绝不包含你的服务器地址、用户名或密码。日志已在此手机上脱敏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會傳送給 OpenCode Mobile 團隊。絕不包含你的伺服器位址、使用者名稱或密碼。記錄會在這支手機上先行遮蔽。"
          }
        }
      }
    },
