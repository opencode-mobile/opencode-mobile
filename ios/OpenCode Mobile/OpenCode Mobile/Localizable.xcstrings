        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaida, kamēr apakšaģents pabeigs darbu. Aptur, ja %1$lld min nekas nedarbojas."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да заврши подагент. Паузира ако %1$lld минути ништо не работи."
