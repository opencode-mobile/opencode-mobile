    "session_chat_sheet.timeline_style_picker.step_rail.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በሐዲድ ላይ ለእያንዳንዱ እርምጃ አንድ መስመር፣ ወኪሉ ሲሠራ በቀጥታ"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xətt üzərində hər addım üçün bir sətir, agent işlədikcə canlı"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По един ред за стъпка в лента, на живо, докато агентът работи"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রেলে প্রতি ধাপে একটি লাইন, এজেন্ট কাজ করার সময় লাইভ"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedan red po koraku na traci, uživo dok agent radi"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una línia per pas en un carril, en directe mentre l'agent treballa"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden řádek na krok na liště, živě během práce agenta"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én linje pr. trin på et spor, live mens agenten arbejder"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Zeile pro Schritt auf einer Leiste, live, während der Agent arbeitet"
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ལམ་ཐིག་གུ་ ཚད་རིམ་རེ་ལུ་ཐིག་གཅིག་རེ། ལས་ཚབ་གིས་ལཱ་འབད་བའི་སྐབས་ ཐད་ཀར་མཐོང་།"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μία γραμμή ανά βήμα σε μια ράγα, ζωντανά ενώ εργάζεται ο πράκτορας"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One line per step on a rail, live while the agent works"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una línea por paso en un carril, en vivo mientras el agente trabaja"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üks rida sammu kohta rajal, reaalajas, kui agent töötab"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksi rivi vaihetta kohden polulla, päivittyy reaaliajassa agentin työskennellessä"
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein linja fyri hvørt stig á einari skjenu, beinleiðis meðan agenturin arbeiðir"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ligne par étape sur un rail, en direct pendant que l’agent travaille"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रेल पर हर चरण की एक पंक्ति, एजेंट के काम करते समय लाइव"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedan redak po koraku na tračnici, uživo dok agent radi"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lépésenként egy sor egy sínen, élőben, amíg az ügynök dolgozik"
