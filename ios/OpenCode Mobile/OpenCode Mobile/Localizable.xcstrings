    "connection.cleartext.message_hosts" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ከአካባቢዎ አውታረ መረብ ወይም ከTailscale ውጭ ተራ http ይጠቀማሉ። የአገልጋይዎ የይለፍ ቃል እና በክፍለ ጊዜዎችዎ ውስጥ ያለው ሁሉ ሳይመሰጠር ይጓዛል። https፣ VPN ወይም ቱኔል ይምረጡ።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yerli şəbəkənizdən və ya Tailscale-dən kənarda sadə http istifadə edir. Server şifrəniz və sessiyalarınızdakı hər şey şifrələnmədən ötürüləcək. https, VPN və ya tunel seçin."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ използват обикновен http извън локалната ви мрежа или Tailscale. Паролата на сървъра и всичко във вашите сесии ще се предават некриптирани. Предпочетете https, VPN или тунел."
