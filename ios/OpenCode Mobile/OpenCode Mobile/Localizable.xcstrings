    "dictation.model_not_installed_detail" : {
      "comment" : "%1$s is the system (Android or iOS).",
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ዲክቴሽን በዚህ መሣሪያ ላይ ይሠራል፣ ስለዚህ ድምፅዎ በጭራሽ አይሰቀልም። %@ ሞዴሉን አንድ ጊዜ ያወርዳል፣ ለሁሉም መተግበሪያዎች ያቆየዋል።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Səslə yazma bu cihazda işləyir, ona görə səsiniz heç vaxt yüklənmir. %@ modeli bir dəfə endirir və bütün tətbiqlər üçün saxlayır."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диктуването работи на това устройство, така че гласът ви никога не се качва. %@ изтегля модела веднъж и го пази за всички приложения."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিক্টেশন এই ডিভাইসেই চলে, তাই আপনার ভয়েস কখনও আপলোড হয় না। %@ মডেলটি একবার ডাউনলোড করে এবং সব অ্যাপের জন্য রেখে দেয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktiranje radi na ovom uređaju, pa se tvoj glas nikada ne otprema. %@ jednom preuzima model i čuva ga za sve aplikacije."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dictat funciona en aquest dispositiu, així que la teva veu no es puja mai enlloc. %@ baixa el model una sola vegada i el conserva per a totes les aplicacions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktování probíhá přímo v tomto zařízení, takže váš hlas nikdy neopouští zařízení. %@ stáhne model jednou a ponechá ho pro všechny aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktering kører på denne enhed, så din stemme bliver aldrig uploadet. %@ downloader modellen én gang og beholder den til alle apps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Diktat läuft auf diesem Gerät, daher wird deine Stimme nie hochgeladen. %@ lädt das Modell einmal herunter und stellt es allen Apps zur Verfügung."
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ཁ་ནང་ཡིག་འབྲི་འདི་ འཕྲུལ་ཆས་འདི་ནང་གཡོག་བཀོལཝ་ལས་ ཁྱོད་ཀྱི་སྐད་ཆ་ནམ་ཡང་སྐྱེལ་བཙུགས་མི་འབད། %@ གིས་དཔེ་ཚད་འདི་ཐེངས་གཅིག་རྐྱངམ་ཕབ་ལེན་འབད་ཞིནམ་ལས་ གློག་རིམ་ཆ་མཉམ་གྱི་དོན་ལུ་ཉར་ཚགས་འབདཝ་ཨིན།"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η υπαγόρευση εκτελείται στη συσκευή, οπότε η φωνή σας δεν ανεβαίνει ποτέ. Το %@ κατεβάζει το μοντέλο μία φορά και το διατηρεί για όλες τις εφαρμογές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictation runs on this device, so your voice is never uploaded. %@ downloads the model once and keeps it for every app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dictado se ejecuta en este dispositivo, así que tu voz nunca se sube. %@ descarga el modelo una sola vez y lo conserva para todas las apps."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikteerimine töötab selles seadmes, nii et sinu häält ei laadita kunagi üles. %@ laadib mudeli alla ühe korra ja hoiab seda kõigi rakenduste jaoks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanelu toimii tällä laitteella, joten ääntäsi ei koskaan lähetetä minnekään. %@ lataa mallin kerran ja pitää sen kaikkien sovellusten käytössä."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talainnsláttur verður gjørdur á hesi eindini, so røddin hjá tær verður aldri send upp. %@ tekur líkanið niður eina ferð og goymir tað fyri allar appir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dictée s’exécute sur cet appareil : votre voix n’est jamais envoyée. %@ télécharge le modèle une seule fois et le conserve pour toutes les apps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिक्टेशन इसी डिवाइस पर चलता है, इसलिए आपकी आवाज़ कभी अपलोड नहीं होती। %@ मॉडल को एक बार डाउनलोड करके सभी ऐप के लिए रखता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktiranje radi na ovom uređaju, pa se tvoj glas nikad ne prenosi. %@ jednom preuzme model i čuva ga za sve aplikacije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A diktálás az eszközön fut, így a hangod sosem kerül feltöltésre. A(z) %@ egyszer letölti a modellt, és minden alkalmazás számára megtartja."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Թելադրումն աշխատում է այս սարքում, ուստի ձեր ձայնը երբեք չի վերբեռնվում։ %@-ը մոդելը ներբեռնում է մեկ անգամ և պահում բոլոր հավելվածների համար։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikte berjalan di perangkat ini, jadi suara Anda tidak pernah diunggah. %@ mengunduh model sekali dan menyimpannya untuk semua aplikasi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raddinnslátturinn keyrir á þessu tæki, svo röddinni þinni er aldrei hlaðið upp. %@ sækir líkanið einu sinni og geymir það fyrir öll öpp."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dettatura funziona su questo dispositivo, quindi la tua voce non viene mai caricata. %@ scarica il modello una sola volta e lo conserva per tutte le app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力はこのデバイス上で動作するため、音声がアップロードされることはありません。%@がモデルを1回だけダウンロードし、すべてのアプリで共有します。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "კარნახი მუშაობს ამ მოწყობილობაზე, ამიტომ თქვენი ხმა არასდროს იტვირთება. %@ მოდელს ერთხელ ჩამოტვირთავს და ყველა აპისთვის შეინახავს."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការសរសេរតាមសំឡេងដំណើរការលើឧបករណ៍នេះ ដូច្នេះសំឡេងរបស់អ្នកមិនត្រូវបានផ្ទុកឡើងទេ។ %@ ទាញយកម៉ូដែលម្តង ហើយរក្សាទុកសម្រាប់គ្រប់កម្មវិធី។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받아쓰기는 이 기기에서 실행되므로 음성이 업로드되지 않아요. %@에서 모델을 한 번 다운로드해 모든 앱에서 함께 사용해요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການເວົ້າເປັນຂໍ້ຄວາມເຮັດວຽກຢູ່ໃນອຸປະກອນນີ້ ສຽງຂອງທ່ານຈຶ່ງບໍ່ຖືກອັບໂຫຼດ. %@ ດາວໂຫຼດຕົວແບບຄັ້ງດຽວ ແລ້ວເກັບໄວ້ໃຫ້ທຸກແອັບ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktavimas veikia šiame įrenginyje, todėl jūsų balsas niekada nesiunčiamas. %@ vieną kartą atsisiunčia modelį ir naudoja jį visose programėlėse."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktēšana darbojas šajā ierīcē, tāpēc tava balss netiek augšupielādēta. %@ modeli lejupielādē vienreiz un glabā visām lietotnēm."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диктирањето работи на овој уред, па гласот никогаш не се испраќа. %@ го презема моделот еднаш и го чува за сите апликации."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дуугаар бичих нь энэ төхөөрөмж дээр ажилладаг тул таны дуу хэзээ ч байршуулагдахгүй. %@ загварыг нэг удаа татаж, бүх аппад зориулан хадгална."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikte berjalan pada peranti ini, jadi suara anda tidak pernah dimuat naik. %@ memuat turun model sekali dan menyimpannya untuk semua aplikasi."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အသံဖြင့်ရိုက်ခြင်းကို ဤစက်ပေါ်တွင် လုပ်ဆောင်သဖြင့် သင့်အသံကို မည်သည့်အခါမျှ အပ်လုဒ်မလုပ်ပါ။ %@ က မော်ဒယ်ကို တစ်ကြိမ်ဒေါင်းလုဒ်လုပ်ပြီး အက်ပ်အားလုံးအတွက် သိမ်းထားသည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktering kjører på denne enheten, så stemmen din lastes aldri opp. %@ laster ned modellen én gang og beholder den for alle apper."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिक्टेसन यही डिभाइसमा चल्छ, त्यसैले तपाईंको आवाज कहिल्यै अपलोड हुँदैन। %@ ले मोडेल एक पटक डाउनलोड गरी सबै एपका लागि राख्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictatie draait op dit apparaat, dus je stem wordt nooit geüpload. %@ downloadt het model één keer en bewaart het voor alle apps."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dyktowanie działa na tym urządzeniu, więc Twój głos nigdy nie jest wysyłany. System (%@) pobiera model raz i udostępnia go wszystkim aplikacjom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ditado roda neste dispositivo, então sua voz nunca é enviada. %@ baixa o modelo uma vez e o mantém para todos os apps."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictarea rulează pe acest dispozitiv, deci vocea ta nu este trimisă nicăieri. %@ descarcă modelul o singură dată și îl păstrează pentru toate aplicațiile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диктовка работает на этом устройстве, поэтому ваш голос никуда не передаётся. %@ один раз скачивает модель и хранит её для всех приложений."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කථනයෙන් ලිවීම ක්‍රියාත්මක වන්නේ මෙම උපාංගයේය, එබැවින් ඔබේ හඬ කිසිවිටෙකත් උඩුගත නොවේ. %@ ආකෘතිය එක් වරක් බාගෙන සියලු යෙදුම් සඳහා තබාගනී."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktovanie beží v tomto zariadení, takže sa váš hlas nikdy neodosiela inam. %@ stiahne model raz a ponechá ho pre všetky aplikácie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narekovanje deluje v tej napravi, zato se vaš glas nikoli ne naloži na splet. %@ model prenese enkrat in ga shrani za vse aplikacije."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktimi funksionon në këtë pajisje, ndaj zëri yt nuk ngarkohet kurrë. %@ e shkarkon modelin një herë dhe e ruan për të gjitha aplikacionet."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диктирање ради на овом уређају, па се ваш глас никада не отпрема. %@ једном преузима модел и чува га за све апликације."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktering körs på den här enheten, så din röst laddas aldrig upp. %@ laddar ned modellen en gång och behåller den för alla appar."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вурудоти овозӣ дар худи дастгоҳ кор мекунад, бинобар ин овози шумо ҳеҷ гоҳ бор карда намешавад. %@ моделро як бор мегирад ва барои ҳамаи барномаҳо нигоҳ медорад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การถอดเสียงพูดทำงานบนอุปกรณ์นี้ เสียงของคุณจึงไม่ถูกอัปโหลด %@ จะดาวน์โหลดโมเดลเพียงครั้งเดียวและใช้ร่วมกับทุกแอป"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesli ýazmak şu enjamda işleýär, şonuň üçin sesiňiz hiç haçan ýüklenmeýär. %@ modeli bir gezek ýükleýär we ony ähli programmalar üçin saklaýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikte bu cihazda çalışır, bu yüzden sesin asla yüklenmez. %@ modeli bir kez indirir ve tüm uygulamalar için saklar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Диктування працює на цьому пристрої, тож ваш голос ніколи не вивантажується. %@ один раз завантажує модель і зберігає її для всіх застосунків."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovozli kiritish shu qurilmada ishlaydi, shuning uchun ovozingiz hech qachon yuklanmaydi. %@ modelni bir marta yuklab oladi va barcha ilovalar uchun saqlaydi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng nhập bằng giọng nói chạy ngay trên thiết bị này nên giọng nói của bạn không bao giờ được tải lên. %@ tải mô hình một lần và dùng chung cho mọi ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "听写在此设备上运行，你的语音不会被上传。%@ 会下载一次模型，并供所有应用共用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聽寫在此裝置上執行，你的語音不會上傳。%@ 只會下載一次模型，並供所有 App 共用。"
          }
        }
      }
    },
