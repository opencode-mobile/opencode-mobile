        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "មួយបន្ទាត់ក្នុងមួយជំហានលើផ្លូវ បង្ហាញផ្ទាល់ពេលភ្នាក់ងារធ្វើការ"
