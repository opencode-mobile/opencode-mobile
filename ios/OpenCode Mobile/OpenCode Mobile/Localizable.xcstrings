          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примерное распределение входных токенов. «Другое» включает определения инструментов и служебные данные."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ආදාන ටෝකනවල ආසන්න බෙදීම. “වෙනත්” හි මෙවලම් අර්ථ දැක්වීම් සහ අතිරේක ඇතුළත් වේ."
