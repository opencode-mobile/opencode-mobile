    "worktree.name_chars" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ፊደላትን፣ ቁጥሮችን፣ ነጥቦችን፣ ሰረዞችን ወይም ዝቅተኛ መስመሮችን ይጠቀሙ"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hərf, rəqəm, nöqtə, defis və ya alt xətt işlədin"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използвайте букви, цифри, точки, тирета или долни черти"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অক্ষর, সংখ্যা, ডট, ড্যাশ বা আন্ডারস্কোর ব্যবহার করুন"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi slova, brojeve, tačke, crtice ili donje crte"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitza lletres, números, punts, guionets o guions baixos"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použijte písmena, číslice, tečky, pomlčky nebo podtržítka"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug bogstaver, tal, punktummer, bindestreger eller understregninger"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Buchstaben, Zahlen, Punkte, Bindestriche oder Unterstriche verwenden"
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ཡིག་འབྲུ་ ཨང་ཀི་ ཚེག་ ཐིག་ཐུང་ ཡང་ན་ འོག་ཐིག་ཚུ་རྐྱངམ་ཅིག་ལག་ལེན་འཐབ།"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε γράμματα, αριθμούς, τελείες, παύλες ή κάτω παύλες"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use letters, numbers, dots, dashes or underscores"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa letras, números, puntos, guiones o guiones bajos"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasuta tähti, numbreid, punkte, kriipse või alakriipse"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä kirjaimia, numeroita, pisteitä, yhdysmerkkejä tai alaviivoja"
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brúka bókstavir, tøl, punktum, bindistrikur ella undirstrikur"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez des lettres, chiffres, points, tirets ou tirets bas"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अक्षर, अंक, बिंदु, डैश या अंडरस्कोर इस्तेमाल करें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi slova, brojke, točke, crtice ili podcrte"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betűt, számot, pontot, kötőjelet vagy aláhúzást használj"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Օգտագործեք տառեր, թվեր, կետեր, գծիկներ կամ ընդգծումներ"
          }
