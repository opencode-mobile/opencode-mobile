    "settings.recent_window.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ክፍለ-ጊዜዎች በሂደት ላይ ወይም ዝግጁ ሲሆኑ፣ ወይም በዚህ ክልል ውስጥ ሲዘመኑ በቅርብ ጊዜ ውስጥ ይቆያሉ።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessiyalar İşləyir və ya Hazırdır vəziyyətində olduqda, yaxud bu müddət ərzində yeniləndikdə Son bölməsində qalır."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сесиите остават в „Скорошни“, докато са в изпълнение или готови, или ако са обновени в този период."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চলমান বা প্রস্তুত থাকলে, অথবা এই সময়সীমার মধ্যে আপডেট হলে সেশন সাম্প্রতিকে থাকে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesije ostaju u Nedavnim dok su u toku ili spremne, ili ako su ažurirane u ovom periodu."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions es mantenen a Recents mentre estan en execució o a punt, o si s'han actualitzat dins d'aquesta finestra."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relace zůstávají v Nedávných, dokud jsou spuštěné nebo připravené, nebo pokud byly aktualizovány v tomto časovém okně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessioner forbliver under Seneste, mens de kører eller er klar, eller hvis de er opdateret inden for dette vindue."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzungen bleiben unter „Zuletzt“, solange sie laufen oder bereit sind oder innerhalb dieses Zeitraums aktualisiert wurden."
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ལཱ་ཡུན་ཚུ་གཡོག་བཀོལ་བའི་སྐབས་ཡང་ན་གྲ་སྒྲིག་ཐོན་པའི་སྐབས་ཡང་ན་དུས་ཡུན་འདི་ནང་དུས་མཐུན་བཟོ་བའི་སྐབས་ ཉེ་ཆར་ནང་སྡོད་ནི་ཨིན།"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συνεδρίες παραμένουν στα Πρόσφατα όσο είναι σε εκτέλεση ή έτοιμες, ή αν ενημερώθηκαν εντός αυτού του παραθύρου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessions stay in Recent while Running or Ready, or when updated within this window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones permanecen en Recientes mientras están en ejecución o listas, o si se actualizaron dentro de este periodo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seansid jäävad jaotisse Hiljutised, kui need on käimas või valmis või kui neid on selle ajavahemiku jooksul uuendatud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istunnot pysyvät Viimeaikaiset-listalla, kun ne ovat käynnissä tai valmiita tai kun ne on päivitetty tämän aikaikkunan sisällä."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setur verða í Nýligum, meðan tær Koyra ella eru Klárar, ella tá tær eru dagførdar innan fyri hetta tíðarskeiðið."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions restent dans Récentes tant qu’elles sont en cours ou prêtes, ou si elles ont été mises à jour pendant cette période."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेशन \"हाल के\" में तब तक रहते हैं जब तक वे चल रहे हों या तैयार हों, या इस अवधि में अपडेट हुए हों।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesije ostaju u Nedavnima dok su u tijeku ili spremne, odnosno ako su ažurirane unutar ovog razdoblja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A munkamenetek a Legutóbbiak között maradnak, amíg futnak vagy készen állnak, illetve ha ezen az időablakon belül frissültek."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Նիստերը մնում են «Վերջին» բաժնում, քանի դեռ աշխատում են կամ պատրաստ են, կամ եթե թարմացվել են այս ժամանակահատվածում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi tetap di Terbaru selama Berjalan atau Siap, atau bila diperbarui dalam rentang ini."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lotur haldast í Nýlegt meðan þær eru í gangi eða tilbúnar, eða ef þær voru uppfærðar innan þessa tímabils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sessioni restano tra i Recenti finché sono In esecuzione o Pronte, o se aggiornate entro questa finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中または準備完了のセッション、またはこの期間内に更新されたセッションは「最近」に残ります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სესიები რჩება „უახლესში“, სანამ მუშაობს ან მზადაა, ან თუ ამ პერიოდში განახლდა."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សម័យនៅក្នុងថ្មីៗ ពេលកំពុងដំណើរការ ឬរួចរាល់ ឬពេលបានធ្វើបច្ចុប្បន្នភាពក្នុងរយៈពេលនេះ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 중이거나 준비된 세션, 또는 이 기간 안에 업데이트된 세션은 최근 목록에 남아요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ເຊດຊັນຈະຢູ່ໃນຫຼ້າສຸດໃນຂະນະທີ່ກຳລັງແລ່ນ ຫຼື ພ້ອມ, ຫຼືເມື່ອອັບເດດພາຍໃນຊ່ວງເວລານີ້."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesijos lieka skiltyje Naujausi, kol vykdomos ar paruoštos arba kai atnaujintos per šį laikotarpį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesijas paliek sadaļā Nesenās, kamēr tās darbojas vai ir gatavas, vai ja ir atjauninātas šajā periodā."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сесиите остануваат во Неодамнешни додека се Во тек или Подготвени, или кога се ажурирани во овој период."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сесс ажиллаж байгаа буюу бэлэн байх үед, эсвэл энэ хугацаанд шинэчлэгдсэн бол “Сүүлийн” жагсаалтад үлдэнэ."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi kekal dalam Terkini semasa Sedang berjalan atau Sedia, atau apabila dikemas kini dalam tempoh ini."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လုပ်ဆောင်နေစဉ် သို့မဟုတ် အဆင်သင့်ဖြစ်စဉ်၊ သို့မဟုတ် ဤကာလအတွင်း အပ်ဒိတ်လုပ်ထားသော ဆက်ရှင်များသည် မကြာသေးမီတွင် ရှိနေမည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesjoner blir værende under Nylige mens de kjører eller er klare, eller når de er oppdatert innenfor dette vinduet."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सत्र चलिरहेको वा तयार हुँदा, वा यो अवधिभित्र अद्यावधिक भएमा हालका सत्रमा रहन्छन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessies blijven bij Recent zolang ze actief of gereed zijn, of als ze binnen deze periode zijn bijgewerkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesje zostają w Ostatnich, gdy są w toku lub gotowe, albo zaktualizowano je w tym oknie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sessões ficam em Recentes enquanto estiverem em execução ou prontas, ou se forem atualizadas dentro desta janela."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesiunile rămân în Recente cât timp sunt În execuție sau Gata, sau dacă au fost actualizate în această fereastră."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сессии остаются в «Недавних», пока они выполняются или готовы, а также если обновлялись за этот период."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සැසි ධාවනය වන විට හෝ සූදානම් විට, නැතහොත් මෙම කාල පරාසය තුළ යාවත්කාලීන වූ විට මෑත ලැයිස්තුවේ රැඳී සිටී."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relácie zostanú v Nedávnych, kým bežia alebo sú pripravené, alebo ak boli aktualizované v tomto okne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seje ostanejo med nedavnimi, dokler se izvajajo ali so pripravljene, ali če so bile posodobljene v tem oknu."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesionet qëndrojnë te Të fundit ndërsa janë në ekzekutim ose gati, ose kur përditësohen brenda kësaj dritareje."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сесије остају у Недавним док раде или су спремне, или када су ажуриране унутар овог прозора."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessioner finns kvar i Senaste medan de körs eller är redo, eller när de uppdaterats inom det här fönstret."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сессияҳо дар «Охирин» мемонанд, то даме ки Дар кор ё Тайёранд, ё дар ин фосила навсозӣ шудаанд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซสชันจะอยู่ในรายการล่าสุดขณะกำลังทำงานหรือพร้อมใช้ หรือเมื่อมีการอัปเดตภายในช่วงเวลานี้"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessiýalar Işleýär ýa-da Taýýar bolanda ýa-da şu aralykda täzelenen bolsa Soňky bölüminde galýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumlar, Çalışıyor veya Hazır olduğu sürece ya da bu aralık içinde güncellendiyse Son'da kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сесії лишаються в «Нещодавніх», поки вони виконуються чи готові або якщо оновлювалися протягом цього періоду."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seanslar ishlayotgan yoki tayyor bo‘lsa, yoki shu oyna ichida yangilangan bo‘lsa, So‘nggilar ro‘yxatida qoladi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên ở lại mục Gần đây khi đang chạy hoặc sẵn sàng, hoặc khi được cập nhật trong khoảng này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话在运行中或就绪时，或在此时间范围内有更新时，会保留在“最近”中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作階段在執行中或就緒時，或在此時間範圍內有更新時，會保留在「最近」。"
          }
        }
      }
    },
