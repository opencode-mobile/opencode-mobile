    "archived_sessions.delete_dialog.message" : {
      "comment" : "%@ is the session title.",
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ከአገልጋዩ ይሰረዛል። ይህ መቀልበስ አይቻልም።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” serverdən silinəcək. Bunu geri qaytarmaq olmaz."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ще бъде изтрита от сървъра. Това действие е необратимо."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” সার্ভার থেকে মুছে যাবে। এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ se briše sa servera. Ovo se ne može poništiti."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» se suprimirà del servidor. Aquesta acció no es pot desfer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relace „%@“ bude odstraněna ze serveru. Tuto akci nelze vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” slettes fra serveren. Det kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird vom Server gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” འདི་སར་བར་ལས་བཏོན་གཏང་འོང་། འདི་འབད་བཤོལ་འབད་མི་ཚུགས།"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συνεδρία «%@» θα διαγραφεί από τον διακομιστή. Η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is deleted from the server. This can’t be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» se eliminará del servidor. Esta acción no se puede deshacer."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kustutatakse serverist. Seda ei saa tagasi võtta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” poistetaan palvelimelta. Tätä ei voi kumota."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” verður strikað av ambætaranum. Hetta kann ikki angrast."
