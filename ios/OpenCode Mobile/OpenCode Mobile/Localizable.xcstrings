          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 작업하는 동안 단계마다 한 줄씩 레일에 실시간 표시"
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຂັ້ນຕອນລະແຖວເທິງລາງ, ອັບເດດສົດໆຕອນຕົວແທນເຮັດວຽກ"
          }
        },
        "lt" : {
          "stringUnit" : {
