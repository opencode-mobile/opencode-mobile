          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सन्देशभित्रका कोड ब्लक र कम्पोजरले सत्र च्याटको आकार पछ्याउँछन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
