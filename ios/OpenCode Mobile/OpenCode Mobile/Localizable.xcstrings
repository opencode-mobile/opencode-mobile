    "connection.setup.pair_again.unauthorized" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ አገልጋይ የተቀመጠውን መግቢያ ውድቅ አደረገው። እንደገና ያጣምሩ። አዲስ የይለፍ ቃል ሁሉንም መሣሪያዎች ያስወጣል።"
