        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एपको यो प्रति प्रमाणित गर्न सकिएन। रिपोर्ट App Store, TestFlight वा Play बाट इन्स्टल गरिएको एपबाट मात्र पठाउन सकिन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze kopie van de app kon niet worden geverifieerd. Meldingen kunnen alleen worden verstuurd vanuit een installatie via de App Store, TestFlight of Google Play."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zweryfikować tej kopii aplikacji. Zgłoszenia można wysyłać tylko z instalacji z App Store, TestFlight lub Google Play."
