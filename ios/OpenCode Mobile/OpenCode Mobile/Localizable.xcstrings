          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чекорите во тек на една картичка во живо што се собира во резиме"
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ажиллаж буй алхмууд нэг карт дээр, дараа нь хураангуй болж нугарна"
