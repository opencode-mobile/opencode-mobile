            "state" : "translated",
            "value" : "MCP सर्वर लोड नहीं हो सके। कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP poslužitelje nije moguće učitati. Provjeri vezu i pokušaj ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült betölteni az MCP-kiszolgálókat. Ellenőrizd a kapcsolatot, és próbáld újra."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Չհաջողվեց բեռնել MCP սերվերները։ Ստուգեք կապը և կրկին փորձեք։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat memuat server MCP. Periksa koneksi lalu coba lagi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki tókst að hlaða MCP-netþjóna. Athugaðu tenginguna og reyndu aftur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile caricare i server MCP. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCPサーバーを読み込めませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP სერვერები ვერ ჩაიტვირთა. შეამოწმეთ კავშირი და სცადეთ ხელახლა."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "មិនអាចផ្ទុកម៉ាស៊ីនមេ MCP បានទេ។ សូមពិនិត្យការតភ្ជាប់ រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP 서버를 불러올 수 없어요. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ໂຫຼດເຊີບເວີ MCP ບໍ່ໄດ້. ກວດສອບການເຊື່ອມຕໍ່ແລ້ວລອງໃໝ່."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko įkelti MCP serverių. Patikrinkite ryšį ir bandykite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neizdevās ielādēt MCP serverus. Pārbaudiet savienojumu un mēģiniet vēlreiz."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP серверите не можеа да се вчитаат. Проверете ја врската и обидете се повторно."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP серверүүдийг ачаалж чадсангүй. Холболтоо шалгаад дахин оролдоно уу."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat memuatkan pelayan MCP. Semak sambungan dan cuba lagi."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP ဆာဗာများကို မဖွင့်နိုင်ပါ။ ချိတ်ဆက်မှုကို စစ်ပြီး ထပ်ကြိုးစားပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke laste MCP-servere. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP सर्भरहरू लोड गर्न सकिएन। जडान जाँचेर फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP-servers laden mislukt. Controleer de verbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się wczytać serwerów MCP. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar os servidores MCP. Verifique a conexão e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverele MCP nu s-au putut încărca. Verifică conexiunea și încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить серверы MCP. Проверьте подключение и повторите попытку."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP සේවාදායකයන් පූරණය කළ නොහැකි විය. සම්බන්ධතාව පරීක්ෂා කර නැවත උත්සාහ කරන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servery MCP sa nepodarilo načítať. Skontrolujte pripojenie a skúste to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strežnikov MCP ni bilo mogoče naložiti. Preverite povezavo in poskusite znova."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverat MCP nuk u ngarkuan. Kontrollo lidhjen dhe provo sërish."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP сервери нису учитани. Проверите везу и покушајте поново."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att läsa in MCP-servrar. Kontrollera anslutningen och försök igen."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серверҳои MCP бор нашуданд. Пайвастро санҷед ва аз нав кӯшиш кунед."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหลดเซิร์ฟเวอร์ MCP ไม่ได้ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP serwerlerini ýüklemek başartmady. Birikmäni barlap, täzeden synanyşyň."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP sunucuları yüklenemedi. Bağlantıyı kontrol edip tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося завантажити сервери MCP. Перевірте з’єднання й спробуйте ще раз."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP serverlarni yuklab bo‘lmadi. Ulanishni tekshirib, qayta urining."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể tải máy chủ MCP. Hãy kiểm tra kết nối và thử lại."
