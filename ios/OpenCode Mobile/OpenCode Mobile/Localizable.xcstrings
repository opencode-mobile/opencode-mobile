        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Այս սերվերը մերժեց պահված մուտքի տվյալները։ Կրկին զուգակցեք։ Նոր գաղտնաբառի դեպքում բոլոր սարքերը դուրս կգան համակարգից։"
