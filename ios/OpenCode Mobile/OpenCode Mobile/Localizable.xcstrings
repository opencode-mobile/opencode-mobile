          "stringUnit" : {
            "state" : "translated",
            "value" : "Մեկ տող յուրաքանչյուր քայլի համար, կենդանի՝ գործակալի աշխատանքի ընթացքում"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu baris per langkah pada rel, langsung saat agen bekerja"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein lína fyrir hvert skref á braut, í beinni meðan fulltrúinn vinnur"
