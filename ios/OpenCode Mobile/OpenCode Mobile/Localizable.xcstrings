        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunelul la distanță este salvat. Nu mai ai nimic de ales. Rămâne activ până când dezactivezi accesul la distanță."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённый туннель сохранён. Выбирать больше нечего. Он останется, пока вы не отключите удалённый доступ."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "දුරස්ථ ටනලය සුරකින ලදී. තෝරා ගැනීමට වෙන කිසිවක් නැත. දුරස්ථ ප්‍රවේශය අක්‍රිය කරන තෙක් එය පවතී."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vzdialený tunel je uložený. Nie je čo vyberať. Zostane, kým nevypnete vzdialený prístup."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oddaljeni tunel je shranjen. Drugega ni treba izbirati. Ostane, dokler ne izklopite oddaljenega dostopa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuneli i largët u ruajt. S'ka gjë tjetër për të zgjedhur. Mbetet derisa ta çaktivizosh qasjen në distancë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаљени тунел је сачуван. Нема шта друго да се изабере. Остаје док не искључите удаљени приступ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjärrtunnel sparad. Inget annat att välja. Den finns kvar tills du stänger av fjärråtkomsten."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тунели дурдаст нигоҳ дошта шуд. Чизи дигаре интихоб кардан лозим нест. То хомӯш кардани дастрасии дурдаст боқӣ мемонад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกอุโมงค์ระยะไกลแล้ว ไม่ต้องเลือกอะไรเพิ่ม และจะอยู่แบบนี้จนกว่าคุณจะปิดการเข้าถึงระยะไกล"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzakdan tunnel saklandy. Başga saýlamaga zat ýok. Uzakdan elýeterlilik öçürilýänçä galýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzak tünel kaydedildi. Seçecek başka bir şey yok. Uzak erişimi kapatana kadar kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Віддалений тунель збережено. Більше нічого вибирати не треба. Він діє, доки ви не вимкнете віддалений доступ."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masofaviy tunnel saqlandi. Boshqa tanlov yo‘q. Masofaviy kirishni o‘chirmaguningizcha qoladi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã lưu tunnel từ xa. Không cần chọn gì thêm. Tunnel được giữ cho đến khi bạn tắt truy cập từ xa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存远程隧道，无需再选择。在你关闭远程访问之前会一直保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存遠端通道，無需再選擇。在你關閉遠端存取前都會保留。"
          }
        }
      }
    },
