    "settings.timeline_style.activity_card.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በሂደት ላይ ያሉ እርምጃዎች በአንድ ቀጥታ ካርድ ላይ፣ ከዚያ ወደ ማጠቃለያ ይታጠፋል"
