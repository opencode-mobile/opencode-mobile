    "appearance.sample_assistant_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ሙከራው የክፍለ ጊዜ ኩኪውን `login()` እንደተጠናቀቀ ወዲያውኑ ያነባል፣ ነገር ግን ኩኪው አንድ ቅጽበት ዘግይቶ ይጻፋል።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test sessiya cookie-sini `login()` tamamlanan kimi oxuyur, amma cookie bir tikdən sonra yazılır."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тестът чете бисквитката на сесията веднага след като `login()` приключи, но бисквитката се записва един такт по-късно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`login()` শেষ হওয়ার ঠিক পরেই টেস্টটি সেশন কুকি পড়ে, কিন্তু কুকিটি লেখা হয় এক টিক পরে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test čita kolačić sesije odmah nakon što se `login()` završi, ali se kolačić upisuje jedan ciklus kasnije."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prova llegeix la cookie de sessió just quan `login()` es resol, però la cookie s'escriu un tic més tard."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test čte cookie relace hned po dokončení `login()`, ale cookie se zapíše o tik později."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testen læser sessionscookien lige efter `login()` er afsluttet, men cookien bliver skrevet ét tick senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Test liest das Sitzungs-Cookie direkt nach dem Abschluss von `login()`, aber das Cookie wird einen Tick später geschrieben."
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "བརྟག་ཞིབ་འདི་གིས་ `login()` མཇུག་བསྡུ་ཚརཝ་ད་ཐད་ཀར་ལཱ་ཡུན་གྱི་ཀུ་ཀི་ཀློག་ནི་ཨིན་རུང་ ཀུ་ཀི་འདི་ tick གཅིག་ཤུལ་ལུ་འབྲིསཝ་ཨིན།"
          }
        },
        "el" : {
          "stringUnit" : {
