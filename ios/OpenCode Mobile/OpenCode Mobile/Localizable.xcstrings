    "dictation.model_queued_detail" : {
      "comment" : "%1$s is the system (Android or iOS).",
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ማውረዱን በወረፋ አስቀምጧል። Wi-Fi፣ ባትሪ መሙላት ወይም ነፃ ማከማቻ ሊጠብቅ ይችላል። ከጥቂት ደቂቃዎች በኋላ እንደገና ይመልከቱ።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ endirməni növbəyə qoydu. Endirmə Wi-Fi bağlantısını, şarjı və ya boş yaddaşı gözləyə bilər. Bir neçə dəqiqədən sonra yenidən yoxlayın."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ постави изтеглянето на опашка. Може да изчака Wi-Fi, зареждане или свободно място. Проверете отново след няколко минути."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ডাউনলোডটি সারিতে রেখেছে। এটি Wi-Fi, চার্জ বা খালি স্টোরেজের জন্য অপেক্ষা করতে পারে। কয়েক মিনিট পরে আবার দেখুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem %@ je stavio preuzimanje u red čekanja. Možda čeka Wi-Fi, punjenje ili slobodan prostor. Provjerite ponovo za nekoliko minuta."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha posat la baixada en cua. Pot esperar a tenir Wi-Fi, càrrega o espai lliure. Torna-ho a comprovar d'aquí a uns minuts."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zařadil stažení do fronty. Může čekat na Wi-Fi, nabíjení nebo volné místo. Zkontrolujte to znovu za několik minut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
