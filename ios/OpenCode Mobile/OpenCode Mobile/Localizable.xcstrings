    "session_chat.goal.footnote_active" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከእያንዳንዱ ዙር በኋላ ገምጋሚ ሥራውን ከግቡ ጋር ያነጻጽራል። ወኪሉ ግቡ እስኪሳካ፣ እርስዎን እስኪፈልግ ወይም %1$lld ዙሮች እስኪያልፉ ድረስ ይቀጥላል።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hər növbədən sonra rəyçi işi məqsədə görə yoxlayır. Agent məqsədə çatana, sizə ehtiyac duyana və ya %1$lld mərhələ keçənə qədər davam edir."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "След всеки ход проверяващ сверява работата с целта. Агентът продължава, докато целта бъде постигната, той се нуждае от вас или минат %1$lld кръга."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি টার্নের পর একজন রিভিউয়ার লক্ষ্যের সাথে কাজ মিলিয়ে দেখে। লক্ষ্য অর্জিত হওয়া, আপনার সাহায্যের প্রয়োজন হওয়া বা %1$lld রাউন্ড শেষ হওয়া পর্যন্ত এজেন্ট চলতে থাকে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakon svakog poteza recenzent provjerava rad prema cilju. Agent nastavlja dok cilj nije ispunjen, dok ne zatreba tvoj odgovor ili dok ne prođe %1$lld rundi."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Després de cada torn, un revisor comprova la feina respecte a l’objectiu. L’agent continua fins que s’assoleixi, et necessiti o passin %1$lld rondes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po každém tahu recenzent zkontroluje práci vůči cíli. Agent pokračuje, dokud cíl není splněn, nepotřebuje vás nebo nedosáhne limitu %1$lld kol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter hver omgang tjekker en reviewer arbejdet mod målet. Agenten fortsætter, indtil målet er nået, den har brug for dig, eller der er gået %1$lld runder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach jedem Durchgang gleicht ein Prüfer die Arbeit mit dem Ziel ab. Der Agent macht weiter, bis das Ziel erreicht ist, er dich braucht oder %1$lld Runden vergangen sind."
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ཐེངས་རེ་རེ་གི་ཤུལ་ལུ་ བསྐྱར་ཞིབ་པ་གིས་ ལཱ་འདི་ དམིགས་ཡུལ་དང་ག་དེ་མཐུན་ཡོདམ་ ཞིབ་དཔྱད་འབདཝ་ཨིན། དམིགས་ཡུལ་འགྲུབ་ཚུན་ ཡང་ན་ ཁྱོད་ལུ་དགོ་ཚུན་ ཡང་ན་ སྐོར་ %1$lld ཚར་ཚུན་ ལས་ཚབ་གིས་ འཕྲོ་མཐུདཔ་ཨིན།"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά από κάθε γύρο, ένας αξιολογητής ελέγχει την εργασία με βάση τον στόχο. Ο πράκτορας συνεχίζει μέχρι να επιτευχθεί, να χρειαστεί εσάς ή να περάσουν %1$lld γύροι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After each turn a reviewer checks the work against the goal. The agent keeps going until it is met, it needs you, or %1$lld rounds pass."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras cada turno, un revisor comprueba el trabajo según el objetivo. El agente sigue hasta que se cumpla, te necesite o pasen %1$lld rondas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pärast iga käiku kontrollib ülevaataja tööd eesmärgi suhtes. Agent jätkab, kuni eesmärk on saavutatud, ta vajab sind või on möödunud %1$lld ringi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokaisen vuoron jälkeen tarkastaja vertaa työtä tavoitteeseen. Agentti jatkaa, kunnes tavoite on saavutettu, se tarvitsee sinua tai %1$lld kierrosta on kulunut."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eftir hvørja umferð kannar ein eftirkannari arbeiðið móti málinum. Agenturin heldur fram, til málið er rokkið, hann tørvar teg, ella %1$lld umferðir eru farnar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après chaque échange, un réviseur compare le travail à l’objectif. L’agent continue jusqu’à ce qu’il soit atteint, qu’il ait besoin de vous, ou que %1$lld tours se soient écoulés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर टर्न के बाद एक समीक्षक काम को लक्ष्य से मिलाकर जाँचता है। एजेंट तब तक चलता रहता है, जब तक लक्ष्य पूरा न हो, उसे आपकी ज़रूरत न पड़े या %1$lld राउंड न बीत जाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakon svakog poteza recenzent provjerava rad prema cilju. Agent nastavlja dok cilj nije ostvaren, dok ne zatrebaš ti ili dok se ne dosegne ograničenje od %1$lld krugova."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden forduló után egy ellenőr összeveti a munkát a céllal. Az ügynök akkor áll meg, ha a cél teljesül, ha szüksége van rád, vagy ha letelik %1$lld kör."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Յուրաքանչյուր քայլից հետո վերանայողը ստուգում է աշխատանքը նպատակի համեմատ։ Գործակալը շարունակում է, մինչև նպատակը կատարվի, ձեր օգնությունը պետք լինի կամ անցնի %1$lld փուլ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah tiap giliran, peninjau memeriksa pekerjaan terhadap tujuan. Agen terus bekerja sampai tujuan tercapai, butuh Anda, atau %1$lld putaran berlalu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eftir hverja umferð ber yfirferðaraðili vinnuna saman við markmiðið. Fulltrúinn heldur áfram þar til markmiðinu er náð, hann þarf á þér að halda eða %1$lld umferðir líða."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo ogni turno un revisore controlla il lavoro rispetto all'obiettivo. L'agente prosegue finché non è raggiunto, ha bisogno di te o passano %1$lld round."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターンごとにレビュアーがゴールに照らして作業を確認します。エージェントは、達成するか、あなたの操作が必要になるか、%1$lldラウンドが経過するまで続けます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ყოველი სვლის შემდეგ მიმომხილველი ამოწმებს სამუშაოს მიზანთან. აგენტი აგრძელებს, სანამ მიზანი არ მიიღწევა, თქვენ არ დაგჭირდებით ან %1$lld რაუნდი არ გავა."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បន្ទាប់ពីវេននីមួយៗ អ្នកពិនិត្យនឹងត្រួតពិនិត្យការងារធៀបនឹងគោលដៅ។ ភ្នាក់ងារបន្តរហូតដល់សម្រេច ត្រូវការអ្នក ឬដល់ %1$lld ជុំ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "턴이 끝날 때마다 리뷰어가 목표에 맞는지 작업을 확인해요. 에이전트는 목표를 달성하거나, 내 응답이 필요하거나, %1$lld라운드가 지날 때까지 계속 진행해요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຫຼັງແຕ່ລະຮອບ ຜູ້ກວດສອບຈະກວດວຽກກັບເປົ້າໝາຍ. ຕົວແທນຈະເຮັດຕໍ່ຈົນກວ່າຈະບັນລຸ, ຕ້ອງການທ່ານ, ຫຼືຜ່ານໄປ %1$lld ຮອບ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po kiekvieno atsakymo recenzentas patikrina darbą pagal tikslą. Agentas tęsia, kol tikslas pasiekiamas, kol prireikia jūsų arba kol praeina %1$lld ratų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pēc katras kārtas pārbaudītājs salīdzina darbu ar mērķi. Aģents turpina, līdz mērķis ir sasniegts, vajadzīga tava palīdzība vai kārtu skaits sasniedz %1$lld."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По секој потег рецензент ја проверува работата според целта. Агентот продолжува додека не се исполни, додека не му затреба вашиот одговор или додека не поминат %1$lld круга."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эргэлт бүрийн дараа хянагч ажлыг зорилготой тулгана. Агент зорилго биелэх, танаас оролт шаардлагатай болох эсвэл %1$lld тойрог өнгөрөх хүртэл үргэлжилнэ."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selepas setiap giliran, penyemak menyemak hasil kerja berdasarkan matlamat. Ejen terus bekerja sehingga matlamat dicapai, ejen memerlukan anda, atau %1$lld pusingan berlalu."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အကြိမ်တိုင်းပြီးနောက် စစ်ဆေးသူက လုပ်ငန်းကို ပန်းတိုင်နှင့် တိုက်ဆိုင်စစ်ဆေးမည်။ ပန်းတိုင်ရောက်သည်အထိ၊ သင့်ကို လိုအပ်သည်အထိ၊ သို့မဟုတ် %1$lld ကြိမ်ပြည့်သည်အထိ အေးဂျင့်က ဆက်လုပ်မည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etter hver omgang sjekker en vurderer arbeidet mot målet. Agenten fortsetter til målet er nådd, den trenger deg, eller det har gått %1$lld runder."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हरेक टर्नपछि समीक्षकले काम लक्ष्यसँग जाँच्छ। लक्ष्य पूरा नभएसम्म, तपाईंको आवश्यकता नपरेसम्म, वा %1$lld राउन्ड नबितेसम्म एजेन्ट चलिरहन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na elke beurt controleert een reviewer het werk aan de hand van het doel. De agent gaat door tot het doel is bereikt, hij jou nodig heeft of er %1$lld rondes voorbij zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po każdej turze recenzent sprawdza pracę pod kątem celu. Agent działa dalej, dopóki cel nie zostanie osiągnięty, nie będzie potrzebował Twojej odpowiedzi lub nie minie %1$lld rund."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após cada turno, um revisor confere o trabalho com a meta. O agente continua até a meta ser atingida, precisar de você ou passarem %1$lld rodadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După fiecare răspuns, un evaluator verifică rezultatul față de obiectiv. Agentul continuă până când obiectivul este atins, are nevoie de tine sau trec %1$lld runde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После каждого хода проверяющий сверяет работу с целью. Агент продолжает, пока цель не достигнута, ему не потребуется ваш ответ или не исчерпан лимит раундов (%1$lld)."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "සෑම වාරයකටම පසු සමාලෝචකයෙකු ඉලක්කයට අනුව වැඩ පරීක්ෂා කරයි. ඉලක්කය සපුරන තුරු, ඔබේ අවධානය අවශ්‍ය වන තුරු, හෝ වට %1$lldක් ගතවන තුරු නියෝජිතයා දිගටම කරගෙන යයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po každom ťahu recenzent skontroluje prácu voči cieľu. Agent pokračuje, kým nie je cieľ splnený, nepotrebuje vás alebo nedosiahne limit kôl (%1$lld)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po vsakem obratu pregledovalec preveri delo glede na cilj. Agent nadaljuje, dokler cilj ni dosežen, ne potrebuje vas ali ne doseže omejitve krogov (%1$lld)."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas çdo raundi një rishikues e kontrollon punën me objektivin. Agjenti vazhdon derisa objektivi të arrihet, të ketë nevojë për ty, ose të kalojnë %1$lld raunde."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После сваког потеза рецензент проверава рад у односу на циљ. Агент наставља док циљ не буде испуњен, док му не затребате или док не прође %1$lld кругова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter varje varv kontrollerar en granskare arbetet mot målet. Agenten fortsätter tills målet är uppnått, den behöver dig eller %1$lld omgångar har gått."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баъд аз ҳар навбат баррасӣкунанда корро бо ҳадаф муқоиса мекунад. Агент то иҷрошавии ҳадаф, талаби кумак аз шумо ё гузаштани %1$lld давр идома медиҳад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังแต่ละเทิร์น ผู้ตรวจจะตรวจงานเทียบกับเป้าหมาย เอเจนต์จะทำต่อจนกว่าจะบรรลุ ต้องการคุณ หรือครบ %1$lld รอบ"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her ädimden soň gözden geçiriji işi maksat bilen deňeşdirýär. Agent maksada ýetýänçä, size mätäç bolýança ýa-da %1$lld tapgyr geçýänçä dowam edýär."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her turdan sonra bir gözden geçiren, işi hedefe göre kontrol eder. Ajan; hedefe ulaşılana, sana ihtiyaç duyana veya %1$lld tur geçene kadar devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після кожного ходу рецензент перевіряє роботу на відповідність меті. Агент працює, доки не досягне мети, не потребуватиме вашої участі або не вичерпає ліміт раундів (%1$lld)."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har bir navbatdan keyin tekshiruvchi ishni maqsadga solishtiradi. Agent maqsadga erishguncha, sizga ehtiyoj tug‘ilguncha yoki %1$lld raund o‘tguncha davom etadi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau mỗi lượt, người đánh giá kiểm tra kết quả so với mục tiêu. Tác nhân tiếp tục cho đến khi đạt mục tiêu, cần bạn, hoặc hết %1$lld vòng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一轮结束后，审查员会对照目标检查工作成果。智能体会持续工作，直到目标达成、需要你介入，或已满 %1$lld 轮。"
