        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar esta cópia do app. Relatórios só podem ser enviados de uma instalação da App Store, do TestFlight ou do Google Play."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această copie a aplicației nu a putut fi verificată. Rapoartele se pot trimite doar dintr-o instalare din App Store, TestFlight sau Google Play."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось проверить эту копию приложения. Отчёты можно отправлять только из версии, установленной из App Store, TestFlight или Google Play."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "යෙදුමේ මෙම පිටපත තහවුරු කළ නොහැකි විය. වාර්තා යැවිය හැක්කේ App Store, TestFlight හෝ Play ස්ථාපනයකින් පමණි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Túto kópiu aplikácie sa nepodarilo overiť. Hlásenia možno odosielať iba z inštalácie z App Store, TestFlight alebo Google Play."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te kopije aplikacije ni bilo mogoče preveriti. Poročila je mogoče poslati samo iz namestitve iz App Store, TestFlight ali Google Play."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjo kopje e aplikacionit nuk u verifikua. Raportet mund të dërgohen vetëm nga një instalim nga App Store, TestFlight ose Play."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ова копија апликације није могла да се провери. Извештаји могу да се шаљу само са App Store, TestFlight или Play инсталације."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att verifiera den här kopian av appen. Rapporter kan bara skickas från en installation via App Store, TestFlight eller Play."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ин нусхаи барнома тасдиқ нашуд. Ҳисоботро танҳо аз насби App Store, TestFlight ё Play фиристодан мумкин аст."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบแอปเวอร์ชันนี้ไม่ได้ ส่งรายงานได้เฉพาะจากแอปที่ติดตั้งผ่าน App Store, TestFlight หรือ Play"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programmanyň bu nusgasyny barlap bolmady. Hasabatlary diňe App Store, TestFlight ýa-da Play arkaly gurlan nusgadan iberip bolýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
