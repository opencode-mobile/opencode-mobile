    "settings.timeline_style.step_rail.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በሐዲድ ላይ ለእያንዳንዱ እርምጃ አንድ መስመር፣ ወኪሉ ሲሠራ በቀጥታ"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
