        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "လုပ်ဆောင်နေသောအဆင့်များကို တိုက်ရိုက်ကတ်တစ်ခုတည်းတွင်ပြပြီး အနှစ်ချုပ်အဖြစ် ခေါက်သိမ်းသည်"
          }
        },
        "nb" : {
          "stringUnit" : {
