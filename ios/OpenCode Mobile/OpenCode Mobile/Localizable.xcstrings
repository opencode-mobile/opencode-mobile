    "onboarding.setup.step4.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መነሻ URL + የይለፍ ቃል ያስገቡ። መተግበሪያው GET /global/health ይፈትሻል፣ ከዚያ በዚህ መሣሪያ ላይ የተቀመጠ የአገልጋይ ግንኙነት ይፈጥራል።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Əsas URL və şifrəni daxil edin. Tətbiq GET /global/health ünvanını yoxlayır, sonra bu cihazda server bağlantısını saxlayır."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Въведете базов URL + парола. Приложението проверява GET /global/health, след което запазва връзка със сървъра на това устройство."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
