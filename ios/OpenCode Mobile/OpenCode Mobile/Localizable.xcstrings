        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ထည့်သွင်းတိုကင်များ၏ ခန့်မှန်းခွဲခြမ်းစိတ်ဖြာချက်။ အခြားတွင် ကိရိယာအဓိပ္ပာယ်ဖွင့်ဆိုချက်များနှင့် အပိုဆောင်းပမာဏ ပါဝင်သည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omtrentlig fordeling av input-tokens. Annet omfatter verktøydefinisjoner og overhead."
          }
        },
        "ne" : {
          "stringUnit" : {
