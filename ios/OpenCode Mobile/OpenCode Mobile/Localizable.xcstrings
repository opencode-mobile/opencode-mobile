        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "អ្នកអាចប្តូរបានគ្រប់ពេលនៅក្នុង ការកំណត់ → រចនាប័ទ្មខ្សែពេលវេលា។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
