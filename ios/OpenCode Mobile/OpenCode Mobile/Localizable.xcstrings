    "diagnostics.clear_dialog.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ የተቀመጠውን የምርመራ መዝገብ ያስወግዳል።"
