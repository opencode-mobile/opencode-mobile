          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося перевірити цю копію застосунку. Звіти можна надсилати лише зі встановлень із App Store, TestFlight або Google Play."
          }
        },
        "uz" : {
          "stringUnit" : {
