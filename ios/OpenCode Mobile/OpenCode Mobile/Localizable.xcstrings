    "settings.worktrees.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የእያንዳንዱን ፕሮጀክት worktrees እና ቅርንጫፎች በመነሻ ላይ ያሳያል፣ እና ሲይዙት አዲስ ክፍለ ጊዜ worktree እንዲመርጥ ይፈቅዳል።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hər layihənin worktree və branch-lərini Ana səhifədə göstərin və Yeni sessiya düyməsini basılı saxladıqda worktree seçməyə imkan verin."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показва worktree и клоновете на всеки проект на началния екран и позволява на „Нова сесия“ да избира worktree при задържане."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হোমে প্রতিটি প্রকল্পের worktree ও ব্রাঞ্চ দেখান, আর ধরে রাখলে নতুন সেশনে worktree বেছে নিতে দিন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži worktree-ove i grane svakog projekta na Početnoj i omogući da Nova sesija odabere worktree kad je dugo držiš pritisnutom."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra els worktrees i les branques de cada projecte a Inici, i deixa que Nova sessió triï un worktree quan la mantinguis premuda."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit worktree a větve každého projektu na domovské obrazovce a umožnit tlačítku Nová relace nabídnout výběr worktree po podržení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis hvert projekts worktrees og branches på startsiden, og lad Ny session vælge en worktree, når du holder den nede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worktrees und Branches jedes Projekts auf der Startseite anzeigen und bei „Neue Sitzung“ per langem Drücken einen Worktree wählen."
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ལས་གཞི་རེ་རེ་གི་ worktrees དང་ branches ཚུ་གདོང་ཤོག་ལུ་སྟོན། ལཱ་ཡུན་གསརཔ་གིས་ ཁྱོད་ཀྱིས་བཟུང་བའི་སྐབས་ worktree གདམ་ཁ་འབད་བཅུག།"
