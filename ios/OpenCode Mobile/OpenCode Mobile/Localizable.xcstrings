            "value" : "`login()` විසඳුණු වහාම පරීක්ෂාව සැසි කුකියේ අගය කියවයි, නමුත් කුකිය ලියවෙන්නේ එක් ටික් එකක් පසුවය."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test číta cookie relácie hneď po dokončení `login()`, ale cookie sa zapíše o jeden takt neskôr."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test prebere piškotek seje takoj po vrnitvi `login()`, a se piškotek zapiše en takt pozneje."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testi lexon cookie-n e sesionit menjëherë pasi `login()` zgjidhet, por cookie shkruhet një tik më vonë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тест чита колачић сесије одмах пошто се `login()` разреши, али се колачић записује један такт касније."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
