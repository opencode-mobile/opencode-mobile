    "connection.scanner.card_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ከ opencode pair --remote። ተራው pair QR የሚያሳየው አገልጋዩ ከlocalhost ውጪ ሲደረስ ብቻ ነው።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "opencode pair --remote əmrindən. Sadə pair yalnız server localhost xaricindən əlçatan olduqda QR göstərir."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "От opencode pair --remote. Обикновеният pair показва QR само когато сървърът е достъпен извън localhost."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "opencode pair --remote থেকে। সাধারণ pair শুধু তখনই QR দেখায়, যখন সার্ভার localhost-এর বাইরে থেকে পৌঁছানো যায়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iz opencode pair --remote. Obični pair prikazuje QR samo kada je server dostupan izvan localhosta."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des d'opencode pair --remote. El pair sense opcions només mostra un QR quan el servidor és accessible més enllà de localhost."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z příkazu opencode pair --remote. Běžný pair zobrazí QR kód, jen když je server dostupný i mimo localhost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra opencode pair --remote. Almindelig pair viser kun en QR-kode, når serveren kan nås uden for localhost."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus opencode pair --remote. Ohne Optionen zeigt pair nur dann einen QR-Code an, wenn der Server über localhost hinaus erreichbar ist."
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "opencode pair --remote ལས། སར་བར་འདི་ localhost ལས་ཕྱིར་ལུ་འཛོམས་ཚུགསཔ་ཅིག་འབད་ཞིནམ་ལས་རྐྱངམ་ཅིག་ pair གིས་ QR སྟོནམ་ཨིན།"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Από το opencode pair --remote. Η απλή εντολή pair εμφανίζει QR μόνο όταν ο διακομιστής είναι προσβάσιμος πέρα από το localhost."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From opencode pair --remote. Plain pair shows a QR only when the server is reachable beyond localhost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde opencode pair --remote. Con pair a secas solo se muestra un QR si el servidor es accesible más allá de localhost."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käsust opencode pair --remote. Tavaline pair näitab QR-i ainult siis, kui server on kättesaadav väljaspool localhosti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komennosta opencode pair --remote. Pelkkä pair näyttää QR-koodin vain, kun palvelin on tavoitettavissa localhostin ulkopuolelta."
          }
