          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปสื่อสารกับเซิร์ฟเวอร์ opencode ที่คุณรันเอง ขั้นตอนแบบสั้นอยู่ด้านล่าง ดูรายละเอียดทั้งหมดได้ในเอกสารทางการ"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programma siziň işledýän opencode serweriňiz bilen gürleşýär. Gysga ýol aşakda — doly maglumat resmi resminamalarda."
          }
        },
        "tr" : {
