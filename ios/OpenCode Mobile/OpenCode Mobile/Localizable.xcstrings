    "terminal.close_dialog.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ በአገልጋዩ ላይ ያለውን shell ያቆማል።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, serverdəki shell-i sonlandırır."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това ще прекрати shell-а на сървъра."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এতে সার্ভারে shell-টি শেষ হয়ে যাবে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo završava shell na serveru."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això finalitza el shell al servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tím se ukončí shell na serveru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette afslutter shellen på serveren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird die Shell auf dem Server beendet."
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "འདི་གིས་སར་བར་གུ་ཡོད་པའི་ shell འདི་མཇུག་བསྡུ་འོང་།"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το shell θα τερματιστεί στον διακομιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This ends the shell on the server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto finaliza el shell en el servidor."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See lõpetab serveris shelli töö."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä päättää shellin palvelimella."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hetta endar shellin á ambætaranum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela met fin au shell sur le serveur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे सर्वर पर चल रहा शेल बंद हो जाएगा।"
