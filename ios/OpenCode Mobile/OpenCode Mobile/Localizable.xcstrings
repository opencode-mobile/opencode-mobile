        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu server saxlanılan girişi rədd etdi. Yenidən cütləşdirin. Yeni şifrə bütün cihazları sistemdən çıxarır."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този сървър отхвърли запазения вход. Сдвоете отново. Нова парола отписва всички устройства."
