    "onboarding.unofficial.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile ለopencode ክፍለ ጊዜዎች ቤተኛ ደንበኛ ነው — በሂደት ላይ ያለ ሥራ። የOpenCode ይፋዊ ምርት አይደለም።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile opencode sessiyaları üçün nativ klientdir — hazırlanma mərhələsindədir. Bu, rəsmi OpenCode məhsulu deyil."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile е роден клиент за opencode сесии — в процес на разработка. Не е официален продукт на OpenCode."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile হলো opencode সেশনের জন্য একটি নেটিভ ক্লায়েন্ট — কাজ চলছে। এটি OpenCode-এর অফিসিয়াল পণ্য নয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile je nativni klijent za opencode sesije — u izradi. Nije zvanični OpenCode proizvod."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile és un client natiu per a sessions d'opencode — en desenvolupament. No és un producte oficial d'OpenCode."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile je nativní klient pro relace opencode – stále se vyvíjí. Není to oficiální produkt OpenCode."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile er en native klient til opencode-sessioner – under udvikling. Det er ikke et officielt OpenCode-produkt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile ist ein nativer Client für opencode-Sitzungen – in Entwicklung. Es ist kein offizielles OpenCode-Produkt."
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile འདི་ opencode ལཱ་ཡུན་ཚུ་གི་ཆེད་དུ་བཟོ་བའི་ས་སྐྱེས་མཁོ་སྤྱོད་པ་ཅིག་ཨིནམ་དང་ ད་ལྟོ་བཟོ་བཞིན་ཡོད། འདི་ OpenCode གི་གཞུང་འབྲེལ་ཐོན་རྫས་མེན།"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το OpenCode Mobile είναι μια εγγενής εφαρμογή-πελάτης για συνεδρίες opencode — υπό ανάπτυξη. Δεν είναι επίσημο προϊόν του OpenCode."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile is a native client for opencode sessions — work in progress. It is not an official OpenCode product."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile es un cliente nativo para sesiones de opencode, en desarrollo. No es un producto oficial de OpenCode."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile on opencode'i seansside natiivne klient – töö on pooleli. See ei ole ametlik OpenCode'i toode."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile on natiivi asiakas opencode-istunnoille – työn alla. Se ei ole virallinen OpenCode-tuote."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile er ein native kundi fyri opencode-setur – arbeiðið er enn í gongd. Hetta er ikki ein offisiell OpenCode vøra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile est un client natif pour les sessions opencode — en cours de développement. Ce n’est pas un produit officiel d’OpenCode."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile, opencode सेशन के लिए एक नेटिव क्लाइंट है — काम जारी है। यह OpenCode का आधिकारिक प्रोडक्ट नहीं है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile je nativni klijent za opencode sesije – u izradi. Nije službeni OpenCode proizvod."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az OpenCode Mobile egy natív kliens opencode munkamenetekhez – folyamatban lévő fejlesztés. Nem hivatalos OpenCode termék."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile-ը opencode նիստերի համար նախատեսված հավելված է, որը դեռ մշակման փուլում է։ Այն OpenCode-ի պաշտոնական արտադրանք չէ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile adalah klien native untuk sesi opencode — masih dalam pengembangan. Ini bukan produk resmi OpenCode."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile er natífur biðlari fyrir opencode lotur — í vinnslu. Þetta er ekki opinber OpenCode vara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile è un client nativo per le sessioni opencode, in sviluppo. Non è un prodotto ufficiale di OpenCode."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobileはopencodeセッション用のネイティブクライアントです（開発中）。OpenCodeの公式製品ではありません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile არის opencode-ის სესიების ნატიური კლიენტი — დამუშავების პროცესშია. ის არ არის OpenCode-ის ოფიციალური პროდუქტი."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile គឺជាកម្មវិធីដើមសម្រាប់សម័យ opencode — កំពុងអភិវឌ្ឍ។ វាមិនមែនជាផលិតផលផ្លូវការរបស់ OpenCode ទេ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile은 opencode 세션용 네이티브 클라이언트이며 아직 개발 중이에요. OpenCode의 공식 제품이 아니에요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile ເປັນແອັບເນທີບຂອງເຊດຊັນ opencode — ກຳລັງພັດທະນາຢູ່. ບໍ່ແມ່ນຜະລິດຕະພັນຢ່າງເປັນທາງການຂອງ OpenCode."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile yra savoji opencode sesijų programėlė – kuriama toliau. Tai nėra oficialus OpenCode produktas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile ir natīvs opencode sesiju klients — darbs vēl turpinās. Tas nav oficiāls OpenCode produkts."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile е нативен клиент за opencode сесии — во изработка. Не е официјален производ на OpenCode."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile нь opencode сессүүдэд зориулсан натив клиент бөгөөд хөгжүүлэлт нь үргэлжилж байна. Энэ нь OpenCode-ийн албан ёсны бүтээгдэхүүн биш."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile ialah klien natif untuk sesi opencode — masih dalam pembangunan. Ia bukan produk rasmi OpenCode."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile သည် opencode ဆက်ရှင်များအတွက် native client ဖြစ်ပြီး ဆက်လက်ဖန်တီးနေဆဲဖြစ်သည်။ OpenCode ၏ တရားဝင်ထုတ်ကုန် မဟုတ်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile er en nativ klient for opencode-sesjoner – under utvikling. Det er ikke et offisielt OpenCode-produkt."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile opencode सत्रहरूका लागि नेटिभ क्लाइन्ट हो — काम जारी छ। यो OpenCode को आधिकारिक उत्पादन होइन।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile is een native client voor opencode-sessies — werk in uitvoering. Het is geen officieel OpenCode-product."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile to natywny klient sesji opencode — w trakcie rozwoju. To nie jest oficjalny produkt OpenCode."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O OpenCode Mobile é um cliente nativo para sessões do opencode — em desenvolvimento. Não é um produto oficial do OpenCode."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile este un client nativ pentru sesiunile opencode — în lucru. Nu este un produs OpenCode oficial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile — нативный клиент для сессий opencode, ещё в разработке. Это не официальный продукт OpenCode."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile යනු opencode සැසි සඳහා වන නේටිව් ක්ලයන්ට් යෙදුමකි — සංවර්ධනය වෙමින් පවතී. එය නිල OpenCode නිෂ්පාදනයක් නොවේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile je natívny klient pre relácie opencode – práca na ňom stále prebieha. Nie je to oficiálny produkt OpenCode."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile je izvorni odjemalec za seje opencode – delo v teku. Ni uradni izdelek OpenCode."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile është një klient nativ për sesionet opencode — në zhvillim e sipër. Nuk është produkt zyrtar i OpenCode."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile је изворни клијент за opencode сесије — рад у току. Није званични OpenCode производ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile är en inbyggd klient för opencode-sessioner – under utveckling. Det är inte en officiell OpenCode-produkt."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile муштарии мобилии сессияҳои opencode аст — дар ҳоли таҳия. Ин маҳсулоти расмии OpenCode нест."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile เป็นไคลเอนต์เนทีฟสำหรับเซสชัน opencode ซึ่งยังอยู่ระหว่างพัฒนา และไม่ใช่ผลิตภัณฑ์อย่างเป็นทางการของ OpenCode"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile opencode sessiýalary üçin native kliýent — işlenip düzülýär. Ol resmi OpenCode önümi däl."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile, opencode oturumları için yerel bir istemcidir — geliştirilmeye devam ediyor. Resmî bir OpenCode ürünü değildir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile — нативний клієнт для сесій opencode, у розробці. Це не офіційний продукт OpenCode."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile — opencode seanslari uchun mahalliy klient, ish davom etmoqda. Bu rasmiy OpenCode mahsuloti emas."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile là ứng dụng khách gốc cho các phiên opencode — đang trong quá trình phát triển. Đây không phải sản phẩm chính thức của OpenCode."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Mobile 是 opencode 会话的原生客户端，仍在开发中。它不是 OpenCode 官方产品。"
