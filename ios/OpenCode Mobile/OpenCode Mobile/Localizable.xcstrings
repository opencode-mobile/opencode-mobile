          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introdueix la URL base i la contrasenya. L'aplicació comprova GET /global/health i desa una connexió de servidor en aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
