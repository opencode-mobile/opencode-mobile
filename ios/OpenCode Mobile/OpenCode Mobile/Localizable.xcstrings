        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мессеж болон бичигч доторх кодын блокууд Сессийн чатын хэмжээг дагана."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
