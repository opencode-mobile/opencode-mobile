    "connection.setup.instructions.first_run" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የመጀመሪያው ጊዜ ማስኬድ ወደ አንድ ደቂቃ ይወስዳል። OpenCode 2.0.25 ወይም ከዚያ በላይ ያስፈልጋል። አገልግሎቱ ገና ካልሰራ ይጀምራል።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk işə salınma təxminən bir dəqiqə çəkir. OpenCode 2.0.25 və ya daha yeni versiya lazımdır. Xidmət işləmirsə, avtomatik başlayır."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Първото изпълнение отнема около минута. Изисква OpenCode 2.0.25 или по-нова версия. Услугата се стартира, ако вече не работи."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রথমবার প্রায় এক মিনিট লাগে। OpenCode 2.0.25 বা তার পরের সংস্করণ লাগবে। সার্ভিস চালু না থাকলে নিজে থেকেই চালু হবে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prvo pokretanje traje oko minutu. Potreban je OpenCode 2.0.25 ili noviji. Servis se pokreće ako već nije pokrenut."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera execució triga aproximadament un minut. Cal OpenCode 2.0.25 o posterior. El servei s'inicia si encara no s'està executant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "První spuštění trvá asi minutu. Vyžaduje OpenCode 2.0.25 nebo novější. Služba se spustí, pokud ještě neběží."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Første kørsel tager omkring et minut. Kræver OpenCode 2.0.25 eller nyere. Tjenesten starter, hvis den ikke allerede kører."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der erste Start dauert etwa eine Minute. Erfordert OpenCode 2.0.25 oder neuer. Der Dienst wird gestartet, falls er noch nicht läuft."
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ཐེངས་དང་པོ་ལུ་སྐར་མ་གཅིག་ཅམ་འགོརཝ་ཨིན། OpenCode 2.0.25 ཡང་ན་དེ་ལས་གསརཔ་དགོ། ཞབས་ཏོག་འདི་མ་གཡོག་བཏང་པ་ཅིན་ཁོ་རང་འགོ་བཙུགསཔ་ཨིན།"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρώτη εκτέλεση διαρκεί περίπου ένα λεπτό. Απαιτεί OpenCode 2.0.25 ή νεότερο. Η υπηρεσία ξεκινά αν δεν εκτελείται ήδη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First run takes about a minute. Needs OpenCode 2.0.25 or later. The service starts if it is not already running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera vez tarda cerca de un minuto. Requiere OpenCode 2.0.25 o posterior. El servicio se inicia si aún no está en marcha."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esimene käivitus võtab umbes minuti. Vajab OpenCode'i versiooni 2.0.25 või uuemat. Teenus käivitub, kui see pole veel töös."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensimmäinen suoritus kestää noin minuutin. Vaatii OpenCode 2.0.25:n tai uudemman. Palvelu käynnistyy, jos se ei ole jo käynnissä."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyrstu ferð tekur umleið ein minutt. Krevur OpenCode 2.0.25 ella nýggjari. Tænastan byrjar, um hon ikki longu rennur."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le premier lancement prend environ une minute. Nécessite OpenCode 2.0.25 ou version ultérieure. Le service démarre s'il n'est pas déjà en cours d'exécution."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहली बार चलाने में करीब एक मिनट लगता है। इसके लिए OpenCode 2.0.25 या उसके बाद का वर्शन चाहिए। सेवा चालू न हो तो अपने आप शुरू हो जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prvo pokretanje traje otprilike minutu. Potreban je OpenCode 2.0.25 ili noviji. Usluga se pokreće ako već nije pokrenuta."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az első futtatás körülbelül egy percig tart. OpenCode 2.0.25 vagy újabb szükséges. A szolgáltatás elindul, ha még nem fut."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Առաջին գործարկումը տևում է մոտ մեկ րոպե։ Պահանջվում է OpenCode 2.0.25 կամ ավելի նոր տարբերակ։ Ծառայությունը կգործարկվի, եթե դեռ միացված չէ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proses pertama butuh sekitar satu menit. Perlu OpenCode 2.0.25 atau lebih baru. Layanan akan dijalankan otomatis jika belum berjalan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyrsta keyrsla tekur um það bil mínútu. Krefst OpenCode 2.0.25 eða nýrrar útgáfu. Þjónustan ræsist ef hún er ekki þegar í gangi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prima esecuzione richiede circa un minuto. Serve OpenCode 2.0.25 o successivo. Il servizio si avvia se non è già in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初回は1分ほどかかります。OpenCode 2.0.25以降が必要です。サービスが起動していない場合は自動で起動します。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "პირველ გაშვებას დაახლოებით ერთი წუთი სჭირდება. საჭიროა OpenCode 2.0.25 ან უფრო ახალი. სერვისი ავტომატურად ირთვება, თუ ჯერ არ მუშაობს."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការដំណើរការលើកដំបូងចំណាយពេលប្រហែលមួយនាទី។ ត្រូវការ OpenCode 2.0.25 ឬថ្មីជាងនេះ។ សេវាកម្មនឹងចាប់ផ្ដើម ប្រសិនបើវាមិនទាន់ដំណើរការ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처음 실행에는 약 1분이 걸려요. OpenCode 2.0.25 이상이 필요해요. 서비스가 실행 중이 아니면 자동으로 시작돼요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການແລ່ນຄັ້ງທຳອິດໃຊ້ເວລາປະມານໜຶ່ງນາທີ. ຕ້ອງໃຊ້ OpenCode 2.0.25 ຫຼືໃໝ່ກວ່າ. ບໍລິການຈະເລີ່ມເອງຖ້າຍັງບໍ່ໄດ້ແລ່ນ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pirmas paleidimas trunka apie minutę. Reikia OpenCode 2.0.25 ar naujesnės versijos. Paslauga paleidžiama, jei dar neveikia."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pirmā palaišana aizņem apmēram minūti. Nepieciešams OpenCode 2.0.25 vai jaunāks. Pakalpojums tiek palaists, ja tas vēl nedarbojas."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Првото извршување трае околу една минута. Потребен е OpenCode 2.0.25 или понова верзија. Услугата се стартува ако веќе не работи."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эхний ажиллуулалт нэг минут орчим үргэлжилнэ. OpenCode 2.0.25 буюу түүнээс дээш хувилбар шаардлагатай. Үйлчилгээ ажиллаагүй бол автоматаар эхэлнэ."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Larian pertama mengambil masa kira-kira seminit. Memerlukan OpenCode 2.0.25 atau lebih baharu. Perkhidmatan dimulakan jika belum berjalan."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
