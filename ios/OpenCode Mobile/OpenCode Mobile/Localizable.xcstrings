    "session_chat.goal.waiting_permission" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የፈቃድ ጥያቄ ክፍት ነው። ሲመልሱት ግቡ ይቀጥላል።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İcazə sorğusu açıqdır. Cavab verdikdən sonra məqsəd davam edəcək."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Има отворена заявка за разрешение. Целта продължава, след като отговорите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি অনুমতির অনুরোধ খোলা আছে। আপনি উত্তর দিলে লক্ষ্য আবার চলবে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvoren je zahtjev za dozvolu. Cilj se nastavlja kad odgovoriš."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi ha una sol·licitud de permís oberta. L’objectiu continua quan hi responguis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čeká žádost o oprávnění. Cíl bude pokračovat, jakmile na ni odpovíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tilladelsesanmodning er åben. Målet fortsætter, når du svarer på den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Berechtigungsanfrage ist offen. Das Ziel wird fortgesetzt, sobald du sie beantwortest."
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "གནང་བའི་ཞུ་བ་ཅིག་ ཁ་ཕྱེ་དེ་ཡོད། ཁྱོད་ཀྱིས་ ལན་བཀོད་ཚརཝ་ད་ དམིགས་ཡུལ་ འཕྲོ་མཐུདཔ་ཨིན།"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπάρχει ανοιχτό αίτημα άδειας. Ο στόχος συνεχίζεται μόλις απαντήσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A permission request is open. The goal carries on once you answer it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una solicitud de permiso abierta. El objetivo continúa cuando la respondas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avatud on loataotlus. Eesmärk jätkub, kui sellele vastad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttöoikeuspyyntö on auki. Tavoite jatkuu, kun vastaat siihen."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein loyvisumbøn er opin. Málið heldur fram, tá tú hevur svarað."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une demande d’autorisation est en attente. L’objectif reprend dès que vous y répondez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक अनुमति अनुरोध खुला है। आपके जवाब देने के बाद लक्ष्य आगे बढ़ेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahtjev za dopuštenje je otvoren. Cilj se nastavlja kad odgovoriš."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy engedélykérés nyitva van. A cél folytatódik, miután válaszolsz rá."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Թույլտվության հարցում կա։ Նպատակը կշարունակվի, երբ պատասխանեք։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada permintaan izin yang terbuka. Tujuan berlanjut setelah Anda menjawabnya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heimildarbeiðni er opin. Markmiðið heldur áfram þegar þú svarar henni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'è una richiesta di autorizzazione aperta. L'obiettivo prosegue quando rispondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "権限リクエストが未回答です。回答するとゴールが再開されます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ღიაა ნებართვის მოთხოვნა. მიზანი გაგრძელდება, როცა უპასუხებთ."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "មានសំណើសុំការអនុញ្ញាតមួយកំពុងបើក។ គោលដៅនឹងបន្តបន្ទាប់ពីអ្នកឆ្លើយ។"
          }
        },
