        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worktree-ի հեռացումը ջնջում է դրա պանակը սերվերում։ Նիստերը մնում են, բայց այլևս չեն կարող աշխատել դրանում։"
