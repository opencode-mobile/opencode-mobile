        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "မက်ဆေ့ချ်များနှင့် စာရိုက်ကွက်အတွင်းရှိ ကုဒ်ဘလောက်များသည် ဆက်ရှင်စကားပြော အရွယ်အစားကို လိုက်နာသည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
