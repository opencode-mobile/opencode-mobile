          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Санҷиш кукии сессияро фавран баъди ҳалли `login()` мехонад, аммо кукӣ як тик дертар навишта мешавад."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
