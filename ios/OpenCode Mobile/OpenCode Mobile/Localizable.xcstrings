    "feature_flags.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ባንዲራን መቀየር ከርቀት እሴት የሚቀድም የመሣሪያ መሻሪያ ያዘጋጃል። የርቀት እሴቶች ሲከፈት ይመጣሉ፤ ተግባራዊ የሚሆኑትም በሚቀጥለው ጊዜ ሲከፈት ነው።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayrağı dəyişmək uzaqdakı dəyərdən üstün olan cihaz əvəzləməsi yaradır. Uzaq dəyərlər açılışda alınır və növbəti açılışda tətbiq olunur."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превключването на флаг задава локална стойност на устройството, която има приоритет пред отдалечената. Отдалечените стойности се извличат при стартиране и се прилагат при следващото стартиране."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফ্ল্যাগ পরিবর্তন করলে ডিভাইসে একটি ওভাররাইড সেট হয়, যা রিমোট মানের চেয়ে অগ্রাধিকার পায়। রিমোট মান চালুর সময় আনা হয় এবং পরের বার চালুর সময় প্রয়োগ হয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promjena oznake postavlja zamjenu na uređaju koja ima prednost nad udaljenom vrijednošću. Udaljene vrijednosti se preuzimaju pri pokretanju, a primjenjuju pri sljedećem pokretanju."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si canvies un indicador, es crea una substitució al dispositiu que preval sobre el valor remot. Els valors remots s'obtenen en iniciar l'app i s'apliquen en l'inici següent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přepnutím příznaku nastavíte přepsání na zařízení, které má přednost před vzdálenou hodnotou. Vzdálené hodnoty se stáhnou při spuštění a použijí se při dalším spuštění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du skifter et flag, oprettes en tilsidesættelse på enheden, som går forud for fjernværdien. Fjernværdier hentes ved start og anvendes ved næste start."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du ein Flag umschaltest, wird auf dem Gerät eine Überschreibung gesetzt, die Vorrang vor dem Remote-Wert hat. Remote-Werte werden beim Start abgerufen und beim nächsten Start angewendet."
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "དམརཀ་ཅིག་བསྒྱུར་པ་ཅིན་ཐབས་འཕྲུལ་གྱི་ཚབ་བཙུགས་ཅིག་གཞི་སྒྲིག་འབད་དེ་ཐག་རིང་གི་གྱངས་ཁ་ལས་གཙོ་བོར་འགྱུར། ཐག་རིང་གི་གྱངས་ཁ་ཚུ་འགོ་བཙུགསཔ་ད་ལེན་ཏེ་ཤུལ་མའི་འགོ་བཙུགསཔ་ད་ལག་ལེན་འཐབ་ཀྱི་ཨིན།"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αλλαγή μιας σημαίας ορίζει παράκαμψη στη συσκευή, που υπερισχύει της απομακρυσμένης τιμής. Οι απομακρυσμένες τιμές λαμβάνονται κατά την εκκίνηση και εφαρμόζονται στην επόμενη εκκίνηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switching a flag sets a device override that wins over the remote value. Remote values are fetched on launch and applied at the next launch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cambiar un indicador se aplica una anulación en el dispositivo que prevalece sobre el valor remoto. Los valores remotos se obtienen al iniciar y se aplican en el siguiente inicio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lipu ümberlülitamine seab seadmepõhise ülekirjutuse, mis on kaugväärtusest tähtsam. Kaugväärtused hangitakse käivitamisel ja rakendatakse järgmisel käivitamisel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lipun vaihtaminen asettaa laitekohtaisen ohituksen, joka on etusijalla etäarvoon nähden. Etäarvot haetaan käynnistyksen yhteydessä ja otetaan käyttöön seuraavalla käynnistyskerralla."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá tú skiftir eitt merki, verður sett ein yvirskriving á tilfarinum, sum gongur framum fjarvirðið. Fjarvirði verða heintað við byrjan og nýtt næstu ferð appin byrjar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier un indicateur définit un remplacement sur l’appareil, prioritaire sur la valeur distante. Les valeurs distantes sont récupérées au lancement et appliquées au lancement suivant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़्लैग बदलने पर डिवाइस ओवरराइड सेट होता है, जो रिमोट वैल्यू से ऊपर रहता है। रिमोट वैल्यू लॉन्च पर लाई जाती हैं और अगले लॉन्च पर लागू होती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promjenom oznake postavlja se nadjačavanje na uređaju koje ima prednost pred udaljenom vrijednošću. Udaljene vrijednosti dohvaćaju se pri pokretanju, a primjenjuju pri sljedećem pokretanju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kapcsoló átváltása eszközszintű felülbírálást állít be, amely felülírja a távoli értéket. A távoli értékek indításkor töltődnek le, és a következő indításkor lépnek életbe."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դրոշը փոխելիս սարքում սահմանվում է վերասահմանում, որը գերակայում է հեռակա արժեքից։ Հեռակա արժեքները բեռնվում են գործարկման ժամանակ և կիրառվում հաջորդ գործարկմանը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengubah flag akan menetapkan override di perangkat yang diprioritaskan atas nilai remote. Nilai remote diambil saat aplikasi dibuka dan diterapkan pada pembukaan berikutnya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þegar þú skiptir um rofa verður til yfirstýring á tækinu sem gengur framar fjargildinu. Fjargildi eru sótt við ræsingu og tekin í notkun við næstu ræsingu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivare o disattivare un flag imposta un override sul dispositivo che ha la precedenza sul valore remoto. I valori remoti vengono scaricati all'avvio e applicati all'avvio successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フラグを切り替えると、リモートの値より優先されるデバイスの上書きが設定されます。リモートの値は起動時に取得され、次回の起動で適用されます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დროშის გადართვა ადგენს მოწყობილობის გადაფარვას, რომელიც დისტანციურ მნიშვნელობას ჭარბობს. დისტანციური მნიშვნელობები იტვირთება გაშვებისას და გამოიყენება შემდეგ გაშვებაზე."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការបើកបិទ flag កំណត់ការកំណត់ជំនួសលើឧបករណ៍ ដែលមានអាទិភាពលើតម្លៃពីចម្ងាយ។ តម្លៃពីចម្ងាយត្រូវបានទាញយកពេលបើកកម្មវិធី ហើយអនុវត្តនៅការបើកលើកក្រោយ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플래그를 바꾸면 원격 값보다 우선하는 기기 재정의가 설정돼요. 원격 값은 실행할 때 가져오고 다음 실행 때 적용돼요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການສະຫຼັບ flag ຈະຕັ້ງການແທນທີ່ໃນອຸປະກອນ ເຊິ່ງມີຄວາມສຳຄັນກວ່າຄ່າຈາກໄລຍະໄກ. ຄ່າຈາກໄລຍະໄກຈະຖືກດຶງຕອນເປີດແອັບ ແລະນຳໃຊ້ຕອນເປີດຄັ້ງຕໍ່ໄປ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perjungus vėliavėlę, įrenginyje nustatoma reikšmė, kuri turi pirmenybę prieš nuotolinę. Nuotolinės reikšmės gaunamos paleidžiant ir pritaikomos kitą kartą paleidus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karoga pārslēgšana iestata ierīces pārrakstījumu, kam ir prioritāte pār attālo vērtību. Attālās vērtības tiek ielādētas palaišanas brīdī un piemērotas nākamajā palaišanā."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Префрлањето на знамето поставува замена на уредот што има предност пред оддалечената вредност. Оддалечените вредности се преземаат при стартување и се применуваат при следното стартување."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Флагийг сольсноор төхөөрөмжийн утга тохируулагдаж, алсын утгаас давамгайлна. Алсын утгууд аппыг эхлүүлэх үед татагдаж, дараагийн эхлүүлэлтээр хэрэгжинэ."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menukar flag menetapkan penimpaan peranti yang mengatasi nilai jarak jauh. Nilai jarak jauh diambil semasa pelancaran dan digunakan pada pelancaran seterusnya."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "flag တစ်ခုကို ပြောင်းလိုက်ပါက အဝေးမှတန်ဖိုးထက် ဦးစားပေးသော စက်ပေါ်ရှိ override ကို သတ်မှတ်သည်။ အဝေးမှတန်ဖိုးများကို အက်ပ်ဖွင့်ချိန်တွင် ရယူပြီး နောက်တစ်ကြိမ်ဖွင့်ချိန်တွင် အသုံးပြုသည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du slår et flagg av eller på, settes en overstyring på enheten som går foran fjernverdien. Fjernverdier hentes ved oppstart og tas i bruk ved neste oppstart."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ्ल्याग बदल्दा डिभाइस ओभरराइड सेट हुन्छ, जसले रिमोट मानभन्दा प्राथमिकता पाउँछ। रिमोट मानहरू सुरु हुँदा ल्याइन्छन् र अर्को पटक सुरु हुँदा लागू हुन्छन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een flag omzetten stelt een override op dit apparaat in die voorrang heeft op de externe waarde. Externe waarden worden bij het opstarten opgehaald en bij de volgende start toegepast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przełączenie flagi ustawia nadpisanie na urządzeniu, które ma pierwszeństwo przed wartością zdalną. Wartości zdalne są pobierane przy uruchomieniu i stosowane przy następnym uruchomieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternar uma flag define uma substituição no dispositivo, que prevalece sobre o valor remoto. Os valores remotos são buscados na abertura e aplicados na próxima abertura."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comutarea unui flag setează o suprascriere pe dispozitiv, care are prioritate față de valoarea de la distanță. Valorile de la distanță se preiau la pornire și se aplică la pornirea următoare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключение флага задаёт переопределение на устройстве, которое приоритетнее удалённого значения. Удалённые значения загружаются при запуске и применяются при следующем запуске."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ධජයක් මාරු කිරීමෙන් දුරස්ථ අගයට වඩා ප්‍රමුඛ වන උපාංග අභිභවනයක් සැකසේ. දුරස්ථ අගයන් ආරම්භයේදී ලබා ගෙන ඊළඟ ආරම්භයේදී යෙදේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepnutím príznaku sa nastaví prepísanie na zariadení, ktoré má prednosť pred vzdialenou hodnotou. Vzdialené hodnoty sa načítajú pri spustení a použijú sa pri ďalšom spustení."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preklop zastavice nastavi preglasitev na napravi, ki prevlada nad oddaljeno vrednostjo. Oddaljene vrednosti se pridobijo ob zagonu in uporabijo ob naslednjem zagonu."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ndërrimi i një flamuri vendos një mbishkrim në pajisje që mbizotëron mbi vlerën në distancë. Vlerat në distancë merren gjatë nisjes dhe zbatohen në nisjen tjetër."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укључивање или искључивање флага поставља локално надјачавање на уређају које има предност над удаљеном вредношћу. Удаљене вредности се преузимају при покретању и примењују при следећем покретању."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att slå om en flagga sätter en åsidosättning på enheten som går före fjärrvärdet. Fjärrvärden hämtas vid start och tillämpas vid nästa start."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Иваз кардани парчам ивазкунии дастгоҳро танзим мекунад, ки аз қимати дурдаст афзалтар аст. Қиматҳои дурдаст ҳангоми оғоз гирифта мешаванд ва дар оғози оянда татбиқ мегарданд."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสลับแฟลกจะตั้งค่าการแทนที่ในอุปกรณ์ ซึ่งมีผลเหนือค่าจากระยะไกล ค่าจากระยะไกลจะถูกดึงตอนเปิดแอปและมีผลในการเปิดครั้งถัดไป"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baýdagy çalşyrmak uzakdaky bahadan ileri geçýän enjam üstünden ýazmasyny belleýär. Uzakdaky bahalar açylanda alynýar we indiki açylanda ulanylýar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir bayrağı değiştirmek, uzak değerin önüne geçen bir cihaz geçersiz kılması ayarlar. Uzak değerler açılışta alınır ve bir sonraki açılışta uygulanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемикання прапорця задає перевизначення на пристрої, яке має пріоритет над віддаленим значенням. Віддалені значення отримуються під час запуску й застосовуються під час наступного."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayroqni o‘zgartirish qurilmada masofaviy qiymatdan ustun turadigan qiymat o‘rnatadi. Masofaviy qiymatlar ishga tushganda olinadi va keyingi ishga tushirishda qo‘llanadi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật hoặc tắt một cờ sẽ đặt ghi đè trên thiết bị, ưu tiên hơn giá trị từ xa. Giá trị từ xa được lấy khi khởi chạy và áp dụng ở lần khởi chạy sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换开关会在此设备上设置一个覆盖值，优先于远程值。远程值在启动时获取，并在下次启动时生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切換旗標會設定裝置覆寫，優先於遠端的值。遠端的值會在啟動時取得，並於下次啟動時套用。"
          }
        }
      }
    },
