        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই সার্ভার সংরক্ষিত সাইন-ইন গ্রহণ করেনি। আবার পেয়ার করুন। নতুন পাসওয়ার্ড দিলে সব ডিভাইস সাইন আউট হয়ে যাবে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj server je odbio sačuvanu prijavu. Upari ponovo. Nova lozinka odjavljuje sve uređaje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest servidor ha rebutjat l'inici de sessió desat. Torna a aparellar. Una contrasenya nova tanca la sessió a tots els dispositius."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server odmítl uložené přihlášení. Spárujte znovu. Nové heslo odhlásí všechna zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren afviste det gemte login. Par igen. En ny adgangskode logger alle enheder ud."
