    "worktrees.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "worktree ማስወገድ አቃፊውን በአገልጋዩ ላይ ይሰርዛል። ክፍለ ጊዜዎቹ ይቆያሉ፣ ግን በውስጡ እንደገና መሥራት አይችሉም።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worktree-ni silmək serverdəki qovluğunu silir. Sessiyalar qalır, amma bir daha orada işləyə bilməz."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Премахването на worktree изтрива папката му на сървъра. Сесиите му остават, но не могат да се стартират отново в него."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "worktree সরালে সার্ভার থেকে এর ফোল্ডার মুছে যায়। এর সেশনগুলো থেকে যায়, কিন্তু আর এতে চালানো যায় না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanjanjem worktree-a briše se njegov folder na serveru. Sesije ostaju, ali se u njemu više ne mogu pokretati."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si elimines un worktree, se suprimeix la seva carpeta al servidor. Les sessions es conserven, però no s'hi podran tornar a executar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebráním worktree se smaže jeho složka na serveru. Relace zůstanou, ale už v něm nepoběží."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du fjerner en worktree, slettes mappen på serveren. Sessionerne bevares, men kan ikke køre i den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Entfernen eines Worktrees wird sein Ordner auf dem Server gelöscht. Die zugehörigen Sitzungen bleiben erhalten, können aber nicht mehr darin ausgeführt werden."
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "worktree བཏོན་པ་ཅིན་ སར་བར་གུ་ཡོད་པའི་སྣོད་འཛིན་བཏོན་གཏང་ནི་ཨིན། ལཱ་ཡུན་ཚུ་སྡོད་འོང་ འོན་ཀྱང་ འདི་ནང་ལོག་གཡོག་བཀོལ་མི་ཚུགས།"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αφαίρεση ενός worktree διαγράφει τον φάκελό του στον διακομιστή. Οι συνεδρίες του παραμένουν, αλλά δεν μπορούν να εκτελεστούν ξανά σε αυτό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removing a worktree deletes its folder on the server. Its sessions stay, but can’t run in it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar un worktree se borra su carpeta en el servidor. Sus sesiones se conservan, pero no podrán ejecutarse de nuevo en él."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worktree’i eemaldamine kustutab selle kausta serveris. Selle seansid jäävad alles, kuid neid ei saa seal enam käitada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worktreen poistaminen poistaa sen kansion palvelimelta. Sen istunnot säilyvät, mutta niitä ei voi ajaa siinä enää."
