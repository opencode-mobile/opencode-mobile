        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera supprimée du serveur. Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” सर्वर से हटा दिया जाएगा। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
