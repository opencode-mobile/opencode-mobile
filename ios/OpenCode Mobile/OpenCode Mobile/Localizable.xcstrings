    "settings.follow_up.subtitle_queue" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ወረፋ · ለV2 አገልጋዮች ብቻ። V1 ይህን አይደግፍም።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Növbə · Yalnız V2 serverlər. V1 bunu dəstəkləmir."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опашка · само за сървъри V2. V1 не поддържа това."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সারি · শুধু V2 সার্ভারে। V1 এটি সমর্থন করে না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Red čekanja · samo za V2 servere. V1 ovo ne podržava."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cua · Només servidors V2. La V1 no ho admet."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fronta · pouze servery V2. V1 to nepodporuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kø · kun V2-servere. V1 understøtter ikke dette."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warteschlange · Nur für V2-Server. V1 unterstützt dies nicht."
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "གྱལ་བསྒྲིགས། · V2 སར་བར་ཚུ་རྐྱངམ་ཅིག། V1 གིས་རྒྱབ་སྐྱོར་མི་འབདཝ་ཨིན།"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ουρά · Μόνο για διακομιστές V2. Το V1 δεν το υποστηρίζει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queue · V2 servers only. V1 does not support this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cola · Solo servidores V2. V1 no lo admite."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjekord · ainult V2 serveritele. V1 ei toeta seda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jonota · vain V2-palvelimet. V1 ei tue tätä."
          }
        },
        "fo" : {
