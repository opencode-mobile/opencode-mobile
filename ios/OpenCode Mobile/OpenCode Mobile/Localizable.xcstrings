        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση των worktrees και των branches κάθε έργου στην Αρχική και δυνατότητα επιλογής worktree στη Νέα συνεδρία με παρατεταμένο πάτημα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
