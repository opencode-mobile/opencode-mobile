    "servers.remove_dialog.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ መሣሪያ የተቀመጠውን የአገልጋይ ግንኙነት ይረሳዋል። ክፍለ ጊዜዎች በዚያ አገልጋይ ላይ ይቆያሉ። ንቁ አገልጋይ ከሆነ ሌላ ይመርጣሉ — ምንም ከሌለ ወደ የግንኙነት ገጽ ይሄዳሉ።"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihaz saxlanmış server bağlantısını silir. Sessiyalar həmin serverdə qalır. Əgər bu aktiv serverdirsə, başqasını seçəcəksiniz — heç biri qalmasa, Qoşulma ekranına keçəcəksiniz."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това устройство забравя запазената връзка със сървъра. Сесиите остават на този сървър. Ако това е активният сървър, ще изберете друг — или ще стигнете до екрана за свързване, ако не остане нито един."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ডিভাইস সংরক্ষিত সার্ভার সংযোগটি ভুলে যাবে। সেশনগুলো ওই সার্ভারেই থাকবে। এটি সক্রিয় সার্ভার হলে আপনি অন্যটি বেছে নেবেন — অথবা কোনোটি না থাকলে সংযোগ করুন স্ক্রিনে যাবেন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj uređaj zaboravlja sačuvanu vezu sa serverom. Sesije ostaju na tom serveru. Ako je to aktivni server, odabrat ćeš drugi — ili ćeš otići na Poveži ako nijedan ne ostane."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest dispositiu oblidarà la connexió del servidor desada. Les sessions es queden al servidor. Si és el servidor actiu, n'hauràs de triar un altre o aniràs a Connecta't si no en queda cap."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zařízení zapomene uložené připojení k serveru. Relace zůstanou na tomto serveru. Pokud je server aktivní, vyberete jiný – nebo se zobrazí obrazovka Připojte se, pokud žádný nezbude."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhed glemmer serverforbindelsen. Sessioner forbliver på serveren. Hvis det er den aktive server, vælger du en anden – eller kommer til Forbind, hvis der ikke er flere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät vergisst die gespeicherte Serververbindung. Die Sitzungen bleiben auf dem Server. Wenn es der aktive Server ist, wählst du einen anderen – oder landest bei „Verbinden“, falls keiner übrig ist."
          }
        },
        "dz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ཐབས་འཕྲུལ་འདི་གིས་ སར་བར་འབྲེལ་མཐུད་ཉར་ཚགས་འདི་ བརྗེད་འགྱོཝ་ཨིན། ལཱ་ཡུན་ཚུ་ སར་བར་དེ་ལུ་ལུས་འོང་། འདི་ལག་ལེན་འཐབ་བཞིན་པའི་སར་བར་ཨིན་པ་ཅིན་ གཞན་ཅིག་སེལ་འོང་ ཡང་ན་ གཞན་མེད་པ་ཅིན་ འབྲེལ་མཐུད་ཤོག་ལེབ་ལུ་འགྱོ་འོང་།"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η συσκευή θα ξεχάσει την αποθηκευμένη σύνδεση διακομιστή. Οι συνεδρίες παραμένουν στον διακομιστή. Αν είναι ο ενεργός διακομιστής, θα επιλέξετε άλλον ή θα μεταβείτε στη Σύνδεση, αν δεν απομένει κανένας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device forgets the Connection Profile. Sessions stay on that server. If it’s the active server, you’ll pick another — or land on Connect if none remain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo olvidará la conexión guardada. Las sesiones permanecen en ese servidor. Si es el servidor activo, elegirás otro o irás a Conectar si no queda ninguno."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See seade unustab salvestatud serveriühenduse. Seansid jäävad sellesse serverisse. Kui see on aktiivne server, valid järgmise – või jõuad ühendamise lehele, kui servereid enam pole."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä laite unohtaa tallennetun palvelinyhteyden. Istunnot säilyvät kyseisellä palvelimella. Jos se on aktiivinen palvelin, valitset toisen – tai päädyt Yhdistä-näkymään, jos yhteyksiä ei jää."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henda eindin gloymir goymda ambætarasambandið. Setur verða verandi á ambætaranum. Er hann virkin ambætari, velur tú ein annan – ella kemur til Samband, um eingin er eftir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil oublie la connexion enregistrée. Les sessions restent sur ce serveur. S’il s’agit du serveur actif, vous en choisirez un autre, ou vous arriverez sur l’écran de connexion s’il n’en reste aucun."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह डिवाइस सहेजा गया सर्वर कनेक्शन भूल जाएगा। सेशन उसी सर्वर पर बने रहेंगे। अगर यह सक्रिय सर्वर है, तो आप दूसरा चुनेंगे — या कोई न बचने पर कनेक्ट स्क्रीन पर पहुँचेंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj uređaj zaboravlja spremljenu vezu s poslužiteljem. Sesije ostaju na tom poslužitelju. Ako je to aktivni poslužitelj, odabrat ćeš drugi ili ćeš doći na zaslon Poveži se ako nijedan ne ostane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az eszköz elfelejti a mentett kiszolgálókapcsolatot. A munkamenetek a kiszolgálón maradnak. Ha ez az aktív kiszolgáló, másikat kell választanod, vagy ha nincs több, a Csatlakozás képernyőre kerülsz."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Այս սարքը կմոռանա պահված սերվերի կապը։ Նիստերը կմնան այդ սերվերում։ Եթե սա ակտիվ սերվերն է, կընտրեք մեկ այլ սերվեր, իսկ եթե այլ սերվեր չմնա, կանցնեք միացման էջին։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat ini akan melupakan koneksi server tersebut. Sesi tetap ada di server itu. Jika itu server aktif, Anda akan memilih yang lain — atau diarahkan ke layar Hubungkan jika tidak ada lagi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta tæki gleymir netþjónstengingunni. Lotur haldast á þeim netþjóni. Ef þetta er virki netþjónninn velur þú annan — eða endar á Tengdu ef enginn er eftir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo dimenticherà la connessione server. Le sessioni restano su quel server. Se è il server attivo, ne sceglierai un altro, oppure arriverai a Connetti se non ne restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスから保存済みのサーバー接続を削除します。セッションはそのサーバーに残ります。使用中のサーバーの場合は別のサーバーを選びます。ほかに残っていない場合は接続画面に移ります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს მოწყობილობა სერვერის შენახულ კავშირს დაივიწყებს. სესიები იმ სერვერზე დარჩება. თუ ეს აქტიური სერვერია, აირჩევთ სხვას — ან დაკავშირების ეკრანზე მოხვდებით, თუ სხვა არ დარჩა."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ឧបករណ៍នេះនឹងភ្លេចការតភ្ជាប់ម៉ាស៊ីនមេ។ សម័យនៅតែមាននៅលើម៉ាស៊ីនមេនោះ។ ប្រសិនបើវាជាម៉ាស៊ីនមេសកម្ម អ្នកនឹងជ្រើសរើសមួយទៀត — ឬទៅកាន់ការភ្ជាប់ ប្រសិនបើគ្មានសល់។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 저장된 서버 연결이 제거돼요. 세션은 해당 서버에 그대로 남아요. 현재 사용 중인 서버라면 다른 서버를 선택하게 되고, 남은 서버가 없으면 연결 화면으로 이동해요."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ອຸປະກອນນີ້ຈະລືມການເຊື່ອມຕໍ່ເຊີບເວີທີ່ບັນທຶກໄວ້. ເຊດຊັນຍັງຢູ່ໃນເຊີບເວີນັ້ນ. ຖ້າເປັນເຊີບເວີທີ່ໃຊ້ຢູ່, ທ່ານຈະເລືອກອັນອື່ນ — ຫຼືໄປທີ່ໜ້າເຊື່ອມຕໍ່ຖ້າບໍ່ມີເຫຼືອ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šis įrenginys pamirš išsaugotą serverio ryšį. Sesijos lieka tame serveryje. Jei tai aktyvus serveris, pasirinksite kitą – arba pateksite į prisijungimo ekraną, jei kitų nebeliks."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šī ierīce aizmirsīs servera savienojumu. Sesijas paliek šajā serverī. Ja tas ir aktīvais serveris, izvēlēsies citu — vai nonāksi pievienošanās ekrānā, ja neviena nepaliek."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Овој уред ја заборава зачуваната врска со серверот. Сесиите остануваат на тој сервер. Ако е активниот сервер, ќе изберете друг — или ќе отидете на екранот за поврзување ако не остане ниеден."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Энэ төхөөрөмж хадгалсан серверийн холболтыг мартана. Сессүүд тэр сервер дээр хэвээр үлдэнэ. Идэвхтэй сервер бол өөр сервер сонгоно — үлдээгүй бол Холбох хуудас руу шилжинэ."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peranti ini akan melupakan sambungan pelayan. Sesi kekal pada pelayan itu. Jika ia pelayan aktif, anda akan memilih yang lain — atau dibawa ke skrin Sambung jika tiada yang tinggal."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤစက်က ဆာဗာချိတ်ဆက်မှုကို မေ့သွားမည်။ ဆက်ရှင်များမှာ ထိုဆာဗာပေါ်တွင် ကျန်ရှိမည်။ အသုံးပြုနေသောဆာဗာ ဖြစ်ပါက အခြားတစ်ခု ရွေးရမည် — မကျန်တော့ပါက ချိတ်ဆက်ရန် စာမျက်နှာသို့ ရောက်မည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enheten glemmer servertilkoblingen. Sesjonene blir liggende på serveren. Hvis det er den aktive serveren, velger du en annen – eller havner på Koble til hvis ingen er igjen."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यो डिभाइसले सुरक्षित सर्भर जडान बिर्सिन्छ। सत्रहरू त्यही सर्भरमा रहन्छन्। यो सक्रिय सर्भर हो भने तपाईंले अर्को छान्नुहुनेछ — कुनै बाँकी छैन भने जडान स्क्रिनमा पुग्नुहुनेछ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat vergeet de opgeslagen serververbinding. Sessies blijven op die server staan. Als het de actieve server is, kies je een andere — of kom je bij Verbinden uit als er geen meer is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie zapomni zapisane połączenie z serwerem. Sesje zostają na tym serwerze. Jeśli to aktywny serwer, wybierzesz inny — albo trafisz do ekranu Połącz, gdy żadnego nie zostanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo esquece a conexão salva. As sessões continuam naquele servidor. Se for o servidor ativo, você escolherá outro — ou voltará para Conectar se não restar nenhum."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest dispozitiv uită conexiunea la server. Sesiunile rămân pe acel server. Dacă este serverul activ, vei alege altul — sau vei ajunge la Conectare dacă nu mai rămâne niciunul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство забудет сохранённое подключение. Сессии останутся на сервере. Если это активный сервер, вы выберете другой — или вернётесь к экрану подключения, если других нет."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙම උපාංගය සුරැකි සේවාදායක සම්බන්ධතාවය අමතක කරයි. සැසි එම සේවාදායකයේම පවතී. එය සක්‍රිය සේවාදායකය නම්, ඔබට තවත් එකක් තෝරා ගැනීමට සිදුවේ — නැතහොත් කිසිවක් ඉතිරි නොවේ නම් සම්බන්ධ කරන්න තිරයට යයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zariadenie zabudne uložené pripojenie k serveru. Relácie zostanú na danom serveri. Ak ide o aktívny server, vyberiete iný – alebo sa zobrazí Pripojiť, ak žiadny nezostane."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta naprava pozabi shranjeno povezavo s strežnikom. Seje ostanejo na tistem strežniku. Če je to aktivni strežnik, boste izbrali drugega – ali pa se vrnili na zaslon za povezavo, če ne ostane noben."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjo pajisje e harron lidhjen e serverit. Sesionet mbeten në atë server. Nëse është serveri aktiv, do të zgjedhësh një tjetër — ose do të shkosh te ekrani Lidhu nëse nuk mbetet asnjë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Овај уређај заборавља сачувану везу са сервером. Сесије остају на том серверу. Ако је то активан сервер, изабраћете други — или ћете доспети на екран за повезивање ако не остане ниједан."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enheten glömmer serveranslutningen. Sessionerna finns kvar på servern. Om det är den aktiva servern väljer du en annan – eller hamnar på Anslut om inga finns kvar."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ин дастгоҳ пайвастшавии нигоҳдошташудаи серверро фаромӯш мекунад. Сессияҳо дар ҳамон сервер мемонанд. Агар ин сервери фаъол бошад, дигареро интихоб мекунед — ё агар чизе намонад, ба саҳифаи пайвастшавӣ мегузаред."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อุปกรณ์นี้จะลืมการเชื่อมต่อเซิร์ฟเวอร์ที่บันทึกไว้ เซสชันยังอยู่บนเซิร์ฟเวอร์นั้น หากเป็นเซิร์ฟเวอร์ที่ใช้งานอยู่ คุณจะได้เลือกเซิร์ฟเวอร์อื่น หรือไปที่หน้าเชื่อมต่อหากไม่เหลือแล้ว"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu enjam serwer birikmesini unudýar. Sessiýalar şol serwerde galýar. Eger ol işjeň serwer bolsa, başga birini saýlarsyňyz — ýa-da hiç biri galmasa, Birikdiriň sahypasyna geçersiňiz."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihaz kayıtlı sunucu bağlantısını unutur. Oturumlar o sunucuda kalır. Etkin sunucuysa başka birini seçersin — hiç kalmadıysa Bağlan ekranına düşersin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей пристрій забуде збережене підключення до сервера. Сесії залишаться на тому сервері. Якщо це активний сервер, ви виберете інший — або потрапите на екран підключення, якщо інших не лишиться."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu qurilma saqlangan server ulanishini unutadi. Seanslar o‘sha serverda qoladi. Agar bu faol server bo‘lsa, boshqasini tanlaysiz — hech biri qolmasa, Ulanish ekraniga o‘tasiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị này sẽ quên kết nối máy chủ đã lưu. Các phiên vẫn nằm trên máy chủ đó. Nếu đây là máy chủ đang dùng, bạn sẽ chọn máy chủ khác — hoặc chuyển đến màn hình Kết nối nếu không còn máy chủ nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备将忘记该服务器连接。会话仍保留在该服务器上。如果它是当前使用的服务器，你需要另选一个；若没有剩余服务器，则会回到连接页面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置會忘記這個伺服器連線，工作階段仍保留在該伺服器上。若它是目前使用的伺服器，你可以改選其他伺服器；若沒有其他伺服器，則會回到連線畫面。"
          }
        }
      }
    },
