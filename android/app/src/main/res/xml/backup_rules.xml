<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing that belongs to a server leaves the device through backups: the credential
  stores, the Connection Profiles and per-session state in DataStore, the Room session
  cache (transcripts), and the debug logs. Only display preferences are backed up.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_connection_credentials.xml" />
    <exclude domain="sharedpref" path="secure_feedback_identity.xml" />
    <exclude domain="database" path="opencode_mobile.db" />
    <exclude domain="database" path="opencode_mobile.db-wal" />
    <exclude domain="database" path="opencode_mobile.db-shm" />
    <exclude domain="file" path="datastore/" />
    <exclude domain="file" path="debug/" />
</full-backup-content>
