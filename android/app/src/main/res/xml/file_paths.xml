<?xml version="1.0" encoding="utf-8"?>
<!-- Only the share directories are exposed through the FileProvider (#755, #898); the rest of
     the cache (attachments, images) is never reachable through a content URI. -->
<paths>
    <cache-path name="diagnostic_logs" path="diagnostic/" />
    <cache-path name="feedback" path="feedback/" />
    <cache-path name="shared_images" path="shared-images/" />
</paths>
