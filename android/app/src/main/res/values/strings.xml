    <string name="onboarding_features_sessions_detail">List, open, create, rename, fork, archive, delete</string>
    <string name="onboarding_features_chat_title">Chat &amp; abort</string>
    <string name="onboarding_features_chat_detail">Send prompts and stop work in flight</string>
    <string name="onboarding_features_permissions_title">Permissions</string>
    <string name="onboarding_features_permissions_detail">Approve or deny requests (no lasting remember)</string>
    <string name="onboarding_features_changes_title">Changes</string>
    <string name="onboarding_features_changes_detail">Inspect session diffs</string>
    <string name="onboarding_features_live_title">Live while open</string>
    <string name="onboarding_features_live_detail">Foreground event stream; refresh after reconnect</string>
    <string name="onboarding_setup_title">Set up opencode serve</string>
    <string name="onboarding_setup_intro">The app talks to an opencode server you run. Short path below — full detail in the official docs.</string>
    <!-- %1$d is the step number. Shown in capitals. -->
    <string name="onboarding_setup_step_number">Step %1$d</string>
    <string name="onboarding_setup_step1_title">Start the server on your machine</string>
    <string name="onboarding_setup_step1_body">In your project, run the opencode server (headless). Keep it running while you use the phone.</string>
    <string name="onboarding_setup_step2_title">Require a password</string>
    <string name="onboarding_setup_step2_body">Set OPENCODE_SERVER_PASSWORD. Username defaults to opencode unless you set OPENCODE_SERVER_USERNAME.</string>
    <string name="onboarding_setup_step3_title">Reach it from your phone</string>
    <string name="onboarding_setup_step3_body">Recommended: Tailscale — install Tailscale on the machine and phone, then use the machine’s Tailscale IP or MagicDNS name as the server URL.\n\nAlso fine: same LAN, VPN, HTTPS, or another tunnel you manage. The app does not create a relay for you.</string>
    <string name="onboarding_setup_step4_title">Connect in the app</string>
    <string name="onboarding_setup_step4_body">Enter base URL + password. The app checks GET /global/health, then saves a Connection Profile on this device.</string>
