    <string name="onboarding_unofficial_title">An unofficial\nopencode client</string>
    <string name="onboarding_unofficial_body">OpenCode Mobile is a native client for opencode sessions — work in progress. It is not an official OpenCode product.</string>
    <string name="onboarding_unofficial_badge">Unofficial</string>
    <string name="onboarding_connect_page_title">Connect to\nyour servers</string>
    <string name="onboarding_connect_page_body">Point the app at an opencode server on your machine. We recommend Tailscale so your phone can reach it securely from anywhere.</string>
    <string name="onboarding_connect_page_setup_link">Need the server first?</string>
    <string name="onboarding_features_title">What you can\ndo from here</string>
