{
  "name": "opencode-mobile",
  "private": true,
  "description": "Dev tooling for opencode-mobile (icon sync, etc.)",
  "scripts": {
    "app-icon:sync": "node scripts/sync-app-icon.mjs",
    "app-icon:sync-store": "node scripts/sync-store-icon.mjs",
    "icons:sync": "node scripts/sync-icons.mjs",
    "file-icons:sync": "node scripts/sync-file-type-icons.mjs",
    "themes:sync": "node scripts/sync-theme-presets.mjs",
    "themes:check": "node scripts/check-theme-presets.mjs",
    "icons:check": "node scripts/check-icons.mjs",
    "icons:audit": "node scripts/audit-icon-usage.mjs",
    "api:fetch": "node scripts/fetch-openapi.mjs",
    "api:generate": "node scripts/generate-api-clients.mjs",
    "api:sync": "npm run api:fetch && npm run api:generate",
    "sse:capture": "node scripts/capture-sse.mjs",
    "store:screenshots": "node scripts/store-screenshots.mjs",
    "store:push": "node scripts/store-screenshots/push-store-shots.mjs",
    "store:upload-app-store": "node scripts/store-screenshots/upload-app-store.mjs",
    "store:fixture-server:test": "node --test scripts/store-screenshots/*.test.mjs",
    "store:screenshots:gallery": "node scripts/store-screenshots/write-gallery.mjs",
    "graphics:editor": "node scripts/launch-graphics/editor.mjs",
    "graphics:render": "node scripts/launch-graphics/render.mjs",
    "graphics:test": "node --test scripts/launch-graphics/*.test.mjs",
    "themes:generate-syntax": "node scripts/generate-syntax-presets.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@shikijs/themes": "4.5.0",
    "html-to-image": "1.11.13",
    "lucide-static": "^1.59.0",
    "puppeteer-core": "25.14.0",
    "svg2vectordrawable": "^2.9.1",
    "yaml": "^2.9.1"
  }
}
